<%
  /*
   * 導覽連結在 build 期就輸出成靜態 <a href>，爬蟲不需要執行 JS 即可取得全站內部連結。
   * 手機選單的開合仍交給 petite-vue（store.nav.active）。
   */
  const navItems = require('_data/nav.js');
  const currentFile = typeof filename !== 'undefined' && filename ? filename : '';
  /* nav.js 存的是站內路徑，前面接上部署子目錄才是真正的網址 */
  const href = (url) => `${process.env.ROOT_DIRECTORY}${url}`;
  /*
   * 資料夾網址（例如 article/）實際的檔名是 article/index.html，
   * 比對前先把結尾的 index.html 拿掉，兩種寫法才對得上。
   */
  const isActive = (url) => url === currentFile.replace(/index\.html$/, '');
  /* 一般項目排成一列；cta（免費體驗）抽出來放最後，做成實心按鈕 */
  const links = navItems.filter((item) => item.navShow && !item.cta);
  const cta = navItems.find((item) => item.navShow && item.cta);
-%>
<div class="m-nav flex flex-row-reverse items-center text-center pt:flex-shrink-0">
  <button aria-label="menu" type="button"
    class="m-nav-btn relative p:hidden tm:block h-[40px] w-[40px] flex-shrink-0 z-10"
    :class="{'active': store.nav.active}" :aria-expanded="!!store.nav.active" @click="store.nav.onClick">
    <i></i>
  </button>
  <%/*
    手機：選單從 header 下緣鋪到畫面底部，logo 與關閉鈕留在上面。
    項目區自己捲動，免費體驗按鈕固定在底部不跟著捲。
  */%>
  <nav class="m-nav-bd" :class="{'active': store.nav.active}" aria-label="主選單">
    <div class="m-nav-scroll">
      <ul class="m-nav-list flex tm:flex-col items-center">
        <% links.forEach((item) => { -%>
        <li class="p:px-[10px] text-[var(--white)] tm:py-[18px]">
          <a href="<%= href(item.url) %>"
            class="t:text-[28px] m:text-[24px] tracking-[-0.1em]<%- isActive(item.url) ? ' tm:underline tm:underline-offset-8' : '' %>"
            <%- isActive(item.url) ? ' aria-current="page"' : '' %>><%= item.label %></a>
        </li>
        <% }); -%>
      </ul>
    </div>
    <% if (cta) { -%>
    <div class="m-nav-cta-wrap">
      <a href="<%= href(cta.url) %>" class="m-nav-cta"<%- isActive(cta.url) ? ' aria-current="page"' : '' %>><%= cta.label %></a>
    </div>
    <% } -%>
  </nav>
</div>
