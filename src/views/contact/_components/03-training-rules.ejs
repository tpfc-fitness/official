<%/* 頭等倉教練的訓練方針 */%>
<% const rules = require('_data/training-rules.js'); -%>
<!-- 訓練方針 -->
<section data-aos="fade-in" class="text-[var(--white)] p:pt-[90px] p:pb-[90px] t:py-[75px] m:py-[40px]">
  <header class="text-center p:pb-[70px] t:pb-[56px] m:pb-[40px] p:px-[60px] t:px-[40px] m:px-[20px]">
    <h2 class="resevation-h1"><%= rules.title %></h2>
    <p class="resevation-h4 text-[var(--x7de9)] p:mt-[18px] tm:mt-[12px]"><%= rules.lead %></p>

    <%/* 三段說明：副標之下、卡片之上，寬度收在 32em 以內才讀得順 */%>
    <div class="p:mt-[24px] tm:mt-[16px] p:max-w-[32em] pt:mx-auto p:space-y-[14px] tm:space-y-[12px]">
      <% rules.body.forEach((line) => { -%>
      <p class="resevation-p"><%= line %></p>
      <% }); -%>
    </div>
  </header>
  <%/* 輪播下面已經沒有東西了，留白交給 section 自己的 padding */%>
  <div class="m-slider pt:mx-auto p:max-w-[1220px]">
    <ul class="training-rules-slider pt:flex">
      <% rules.items.forEach((item) => { -%>
      <li class="p:w-1/4 tm:min-h-[340px]">
        <div
          class="bg-[#fff] text-[var(--black)] h-full p:mx-[10px] p:px-[24px] p:py-[32px] t:px-[20px] t:py-[28px] m:px-[24px] m:py-[32px]">
          <p class="training-rule-no"><%= item.no %></p>
          <h3 class="resevation-h3 deco-line p:mt-[14px] tm:mt-[12px]">
            <% item.title.forEach((line, i) => { -%>
            <%- i ? '<br />' : '' %><%= line %>
            <% }); -%>
          </h3>
          <p class="resevation-p p:mt-[22px] tm:mt-[18px]"><%= item.body %></p>
        </div>
      </li>
      <% }); -%>
    </ul>
    <div class="m-slider-ctrl training-rules-slider-ctrl p:hidden">
      <button type="button" class="m-slider-prev">
        <span class="sr-only">上一張</span>
      </button>
      <button type="button" class="m-slider-next">
        <span class="sr-only">下一張</span>
      </button>
    </div>
  </div>
</section>
