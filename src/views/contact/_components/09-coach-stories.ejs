<%/* 教練故事：Before / After 親身經歷 */%>
<% const coachStories = require('_data/coach-stories.js'); -%>
<!-- 過度 -->
<div class="resevation-bg-02 text-center pt:py-[90px] m:py-[60px]">
  <p class="resevation-p text-[var(--white)]">
    我們並不是一開始就懂得怎麼訓練。<br /><br />
    在成為教練之前，<br />
    我們也曾經卡在自己的身體問題裡，<br />
    嘗試過錯的方法、走過不少冤枉路。<br /><br />
    正因為親身經歷過那些過程，<br />
    才更清楚新手真正需要的是什麼。
  </p>
</div>

<% coachStories.forEach((story) => { -%>
<!-- 教練故事 -->
<section data-aos="fade-in"
  class="flex flex-col items-center text-[var(--white)] bg-[var(--x15)] p:pt-[86px] p:pb-[90px] t:pt-[75px] t:pb-[75px] t:px-[32px] m:pt-[40px] m:pb-[50px] m:px-[20px]">
  <p class="resevation-h3 italic text-center flex items-center justify-center p:mb-[24px] tm:mb-[14px]">
    <%- require('@component/svg.ejs')({
      svgName: 'icon_dumbbel',
      style: {
        main: 'text-[var(--white)] w-[24px] h-[24px] mr-[8px]'
      }
    }) %>
    <%= story.coach %>
  </p>
  <h2 class="resevation-h1 deco-header p:mb-[70px] t:mb-[40px] m:mb-[40px]"><%= story.title %></h2>
  <div class="reservation-card pt:flex items-center t:flex-col p:w-[1200px] p:mb-[70px]">
    <%- require('img.ejs')({
      path: story.before.img,
      alt: story.before.alt,
      style: {
        main: 'resevation-img flex-shrink-0 p:w-[486px] p:h-[315px] t:w-[486px] t:h-[315px] m:w-full',
        img: 'relative'
      }
    }) %>
    <div class="pt:space-y-[12px] m:space-y-[6px] flex-grow p:pl-[50px] tm:mt-[30px]">
      <%/* 紅色的 Before／After 後面接一句中文小標，點出這一段在講什麼 */%>
      <p class="resevation-h4">
        <span class="text-[#E12020]">Before</span>｜<%= story.before.heading %>
      </p>
      <% story.before.paragraphs.forEach((paragraph) => { -%>
      <p class="resevation-p"><%- paragraph %></p>
      <% }); -%>
    </div>
  </div>
  <div class="reservation-card-reverse pt:flex items-center p:flex-row-reverse t:flex-col p:w-[1200px] tm:mt-[60px]">
    <%- require('img.ejs')({
      path: story.after.img,
      alt: story.after.alt,
      style: {
        main: 'resevation-img flex-shrink-0 p:w-[486px] p:h-[315px] t:w-[486px] t:h-[315px] m:w-full',
        img: 'relative'
      }
    }) %>
    <div class="pt:space-y-[12px] m:space-y-[6px] flex-grow p:pr-[50px] tm:mt-[30px]">
      <p class="resevation-h4">
        <span class="text-[#E12020]">After</span>｜<%= story.after.heading %>
      </p>
      <% story.after.paragraphs.forEach((paragraph) => { -%>
      <p class="resevation-p"><%- paragraph %></p>
      <% }); -%>

      <% if (story.closing) { -%>
      <%/*
        收尾：從教練的故事轉向讀者。

        收在 After 這一欄裡，不另外開一塊置中的區段 —— 這一段後面緊接著
        就是頁面的過場文案，那一塊也是置中、也是「如果你⋯⋯」起手，
        兩塊長得一樣會看起來像同一段講了兩次。
        留在欄內、靠左，它就還是 Benson 這段故事的結尾。

        ⚠️ mt 要加 !：外層的 space-y 權重比單獨的 mt 高，不蓋不過去。
      */%>
      <p class="resevation-p p:!mt-[32px] tm:!mt-[24px]"><%= story.closing.lead %></p>

      <%/* 三行是同一句話斷開的，行末的頓號與逗號要留著 */%>
      <p class="resevation-p">
        <% story.closing.points.forEach((line, i) => { -%>
        <%- i ? '<br />' : '' %><%= line %>
        <% }); -%>
      </p>

      <p class="resevation-h4 p:!mt-[24px] tm:!mt-[18px]">
        <% story.closing.conclusion.forEach((line, i) => { -%>
        <%- i ? '<br />' : '' %><%= line %>
        <% }); -%>
      </p>
      <% } -%>
    </div>
  </div>
</section>
<% }); -%>
