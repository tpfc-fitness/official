<%/* 私人教練課程費用 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-service，使用的頁面樣式表必須引入它。
   *
   * ⚠️ 價格的唯一來源是 _data/service.js 的 pricing，
   *    那裡的數字必須與 _data/offers.js、llms.txt 一致。
   *
   * 兩張卡不是三個方案 —— 新生方案本來就是一對一的首購價，
   * 收在一對一卡裡，後續單堂價寫在特色清單的最後一行。
   */
  const { pricing } = require('_data/service.js');
-%>
<section data-aos="fade-in"
  class="text-[var(--white)] bg-[var(--black)] p:px-[60px] p:py-[90px] t:px-[40px] t:py-[64px] m:px-[20px] m:py-[44px]">
  <div class="p:max-w-[1200px] p:mx-auto">
    <header>
      <p class="m-sec-eyebrow"><%= pricing.eyebrow %></p>
      <h2 class="resevation-h1 p:mt-[14px] tm:mt-[10px]"><%= pricing.title %></h2>
    </header>

    <div class="grid p:mt-[48px] t:mt-[36px] m:mt-[24px] p:grid-cols-2 p:gap-[28px] tm:grid-cols-1 tm:gap-[20px]">
      <% pricing.plans.forEach((plan) => { -%>
      <article data-aos="fade-up" class="m-plan-card">
        <p class="flex flex-wrap items-center p:gap-[14px] tm:gap-[10px]">
          <span class="font-bold p:text-[20px] tm:text-[18px]"><%= plan.name %></span>
          <% if (plan.badge) { -%>
          <span class="m-card-badge"><%= plan.badge %></span>
          <% } -%>
        </p>

        <p class="flex items-baseline p:mt-[22px] tm:mt-[16px] p:gap-[12px] tm:gap-[10px]">
          <span class="text-[var(--xc7)] p:text-[16px] tm:text-[14px]"><%= plan.unit %></span>
          <span class="m-plan-amount"><%= plan.price %></span>
        </p>
        <p class="text-[var(--xc7)] p:mt-[8px] tm:mt-[6px] p:text-[15px] tm:text-[13px]"><%= plan.note %></p>

        <ul class="m-plan-checks p:mt-[26px] tm:mt-[20px]">
          <% plan.features.forEach((feature) => { -%>
          <li>
            <%- require('@component/svg.ejs')({
              svgName: 'icon_check',
              style: { main: 'm-plan-check-icon' }
            }) %>
            <span><%= feature %></span>
          </li>
          <% }); -%>
        </ul>
      </article>
      <% }); -%>
    </div>

    <%- require('@component/mBtn.ejs')({
      label: pricing.cta.label,
      link: pricing.cta.link,
      style: {
        main: '--highlight p:mt-[40px] tm:mt-[26px] p:w-[236px] p:h-[52px] tm:w-full tm:h-[48px] p:text-[16px] tm:text-[15px]',
        icon: 'w-[40px]'
      },
      icon: {
        name: 'arrow',
        css: 'w-[18px] h-[18px]'
      },
      fadeType: 'fade-up'
    }) %>
  </div>
</section>
