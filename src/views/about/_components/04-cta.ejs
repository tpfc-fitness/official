<%/* 結尾行動呼籲：想更了解頭等倉？ */%>
<%
  /*
   * 兩顆都走 --border（線框）而不是 --highlight（紅底）——
   * 這兩個去處是並列的，沒有主次之分，其中一顆填滿會變成在替讀者挑。
   */
  const LINKS = [
    { label: '認識教練', link: './ourteam.html' },
    { label: '查看場館', link: './information.html' },
  ];
-%>
<section
  class="bg-[var(--x15)] text-[var(--white)] p:px-[80px] p:py-[80px] t:px-[40px] t:py-[56px] m:px-[20px] m:py-[40px]">
  <div class="p:max-w-[1000px] p:mx-auto text-center">
    <h2 data-aos="fade-up" class="font-bold leading-[1.4] p:text-[34px] t:text-[26px] m:text-[22px]">想更了解頭等倉？</h2>
    <p data-aos="fade-up"
      class="leading-[2] p:mt-[18px] tm:mt-[12px] p:text-[15px] tm:text-[14px] text-[rgb(255_255_255_/_85%)]">
      認識我們的教練與訓練方式。</p>

    <%/* 桌機與平板兩顆並排，手機改成上下堆疊佔滿寬度 */%>
    <div
      class="flex justify-center pt:gap-[20px] m:flex-col m:items-center m:gap-[14px] p:mt-[40px] t:mt-[32px] m:mt-[26px]">
      <% LINKS.forEach((item) => { -%>
      <%- require('@component/mBtn.ejs')({
        label: item.label,
        link: item.link,
        style: {
          main: '--border p:text-[18px] p:w-[244px] p:h-[45px] t:w-[216px] t:h-[50px] m:w-full m:h-[46px]',
          icon: 'w-[45px]'
        },
        icon: {
          name: 'arrow',
          css: 'p:w-[18px] p:h-[18px] tm:w-[24px] tm:h-[24px]'
        },
        fadeType: 'fade-up'
      }) %>
      <% }); -%>
    </div>
  </div>
</section>
