<%/* 想先了解更多？ */%>
<% const post = require('_data/post.js'); -%>
<section class="p:p-[20px] bg-[var(--black)] text-[var(--white)]">
  <h2 class="p:font-bold p:text-[48px] tm:sr-only">想先了解更多？</h2>
  <div class="text-center p:hidden tm:p-[40px]">
    <a href="https://www.instagram.com/tpfc.fitness/" target="_blank" rel="noopener"
      class="block overflow-hidden rounded-full w-[90px] h-[90px] mx-auto mb-[10px] border border-solid border-[var(--white)]">
      <%- require('img.ejs')({
          path: require('@imgs/index/ig_profile.jpg'),
          alt : 'instagram image',
          style: {
            main: 'w-full h-full',
            img: 'object-cover object-center'
          }
        }) %>
    </a>
    <a href="https://www.instagram.com/tpfc.fitness/" target="_blank" rel="noopener"
      class="text-[20px] text-[var(--white)]">
      tpfc.fitness
    </a>
    <%- require('@component/mBtn.ejs')({
        label: 'Follow us',
        link: 'https://www.instagram.com/tpfc.fitness/',
        style: {
          main: '--border mt-[30px] tm:w-[205px] tm:h-[45px] tm:mx-auto',
          icon: 'w-[45px]'
        },
        icon: {
          name: 'logo_ig',
          css: 'tm:w-[20px] tm:h-[20px]'
        }
      }) %>
  </div>
  <ul class="flex flex-wrap tm:p-[4px]">
    <% post.forEach((item) => { -%>
    <li class="p-[4px] p:w-1/4 t:w-1/2 overflow-hidden">
      <a href="<%= item.link %>" target="_blank" rel="noopener" class="m-post relative">
        <h3 class="sr-only"><%= item.title %></h3>
        <%- require('img.ejs')({
            path: item.img,
            alt: item.alt,
            style: {
              main: 'w-full h-full m:w-[360px] m:h-[360px]',
              img: 'object-cover object-center'
            }
          }) %>
        <p
          class="m-post-hover absolute top-0 left-0 w-full h-full backdrop-blur-sm bg-[#fff] bg-opacity-60 font-bold text-[var(--black)] p:p-[30px] p:text-[16px] p:leading-normal">
          <%- item.cnt %></p>
      </a>
    </li>
    <% }); -%>
  </ul>
</section>
