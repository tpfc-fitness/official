<%/* KV：品牌名與即刻預約 */%>
<section class="kv w-full text-center flex flex-col items-center p:p-[80px] tm:p-[30px]">
  <%/*
    KV 照片以真正的 <img> 輸出，不要改回 CSS background-image。

    背景圖的網址只存在於 CSS 裡，瀏覽器的 preload scanner 掃不到，
    必須等 HTML → CSS 下載解析完才會發現這張圖，再開始下載。
    這張圖是本頁的 LCP 元素，實測模擬 4G 下 LCP 被拖到 15.2 秒，
    Lighthouse 的 lcp-discovery 直接標 requestDiscoverable: false。

    改成 <img> 之後它出現在初始 HTML 中，能被提前發現，
    也才吃得到 fetchpriority="high"（由 img.ejs 的 eager 帶出）。
  */%>
  <%- require('img.ejs')({
      eager: true,
      path: require('index/kv.jpg'),
      alt: '教練指導學員重量訓練',
      style: {
        main: 'kv-photo',
        img: 'object-cover'
      }
    }) %>
  <h1 data-aos="fade-up"
    class="kv-title text-[var(--white)] p:font-black tm:font-bold tracking-[-0.05em] p:text-[62px] tm:text-[40px] order-2">
    <%/*
      手機把「｜」換成換行。只藏分隔線的話兩段會黏成一句，
      而且斷在哪裡由容器寬度決定，通常會斷在詞中間。
    */%>
    頭等倉運動空間<span class="m:hidden">｜</span><br class="pt:hidden" />台北中山私人教練</h1>
  <%- require('@component/svg.ejs')({
      svgName: 'logo',
      style: {
        main: 'text-[var(--white)] p:w-[68px] p:h-[60px] tm:w-[60px] tm:h-[54px] order-1'
      }
    }) %>
  <h2 data-aos="fade-up"
    class="text-[var(--white)] p:font-black tm:font-bold tracking-[-0.05em] p:text-[30px] tm:text-[24px] tm:mt-[10px] order-3">
    一對一・一對二教學<br />學會正確訓練，<br class="pt:hidden" />建立屬於自己的運動能力
  </h2>
  <p data-aos="fade-up"
    class="text-[var(--white)] text-center p:text-[18px] tm:text-[15px] p:mt-[16px] tm:mt-[12px] order-4">
    台北市中山區・捷運民權西路站步行 3 分鐘</p>
  <p data-aos="fade-up"
    class="text-[var(--white)] text-center p:text-[18px] tm:text-[15px] p:mt-[16px] tm:mt-[12px] order-4">
    私人教練｜自主訓練｜團課<br />肌力｜改善體態｜增肌減脂｜功能性訓練</p>
  <%- require('@component/mBtn.ejs')({
      label: '即刻預約',
      link: './contact.html',
      style: {
        main: '--border order-5 p:text-[18px] p:w-[244px] mt-[30px] p:h-[45px] t:w-[216px] t:h-[60px] m:w-[140px] m:h-[46px]'
      },
      fadeType: 'fade-up'
    }) %>
</section>
