<%/* KV：關於頭等倉 */%>
<section class="bg-[var(--x15)] text-[var(--white)]">
  <div class="p:max-w-[1920px] p:flex p:items-stretch mx-auto">
    <div class="p:w-[56%] p:flex-shrink-0 p:px-[80px] p:py-[90px] t:px-[40px] t:py-[56px] m:px-[20px] m:py-[40px]">
      <p class="text-[11px] tracking-[0.24em] text-[rgb(255_255_255_/_55%)]">ABOUT US</p>
      <h1 data-aos="fade-up"
        class="font-black leading-[1.15] tracking-[-0.03em] p:mt-[18px] tm:mt-[12px] p:text-[62px] t:text-[40px] m:text-[30px]">
        關於頭等倉</h1>
      <p data-aos="fade-up"
        class="font-bold leading-[1.6] p:mt-[22px] tm:mt-[14px] p:text-[20px] t:text-[17px] m:text-[15px]">
        我們想做的，不只是一間讓你來運動的健身房。</p>

      <i class="block h-px bg-[rgb(255_255_255_/_20%)] p:my-[38px] tm:my-[26px]"></i>

      <p data-aos="fade-up" class="leading-[2] p:text-[15px] tm:text-[14px] text-[rgb(255_255_255_/_85%)]">
        頭等倉運動空間成立於 2022 年。<br>
        我們希望提供的不只是一次訓練，<br class="m:hidden">
        而是一個<b class="font-bold text-[var(--white)]">讓你學會運動、理解自己的身體，最後能夠把運動留在生活裡的地方</b>。
      </p>
    </div>

    <%- require('img.ejs')({
      /* 首屏圖片：立即載入並提高優先度 */
      eager: true,
      path: require('@imgs/about/about_kv.jpg'),
      alt: '頭等倉運動空間訓練環境',
      style: {
        main: 'p:flex-grow p:min-w-0 tm:order-first tm:w-full t:h-[260px] m:h-[180px]',
        img: 'object-cover object-center'
      }
    }) %>
  </div>
</section>
