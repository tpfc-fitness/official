<%/* 課程項目 */%>
<section class="text-[var(--white)] bg-[var(--x1f1d)] p:p-[80px] tm:py-[42px] tm:px-[20px]">
  <div data-aos="fade-right" class="p:flex p:items-center p:max-w-[1400px]">
    <div>
      <h2
        class="leading-[1.4] p:flex-shrink-0 tracking-[-0.05em] font-black p:text-[72px] tm:text-[42px] tm:text-center">
        課程項目</h2>
      <p class="p:w-[490px] text-[14px]">依照你的訓練需求，選擇適合自己的運動方式。</p>
    </div>
    <div class="p:flex-grow tm:py-[20px]">
      <ul class="m-list --heading p:space-y-[20px] tm:space-y-[16px]">
        <li>
          <h3 class="font-bold text-[24px]">1v1／1v2 私人教練</h3>
          <p class="text-[14px]">由教練依照你的訓練經驗與目標安排訓練。</p>
        </li>
        <li>
          <h3 class="font-bold text-[24px]">自主訓練</h3>
          <p class="text-[14px]">適合已有基礎訓練能力，想自行安排訓練者。</p>
        </li>
        <li>
          <h3 class="font-bold text-[24px]">團體課程</h3>
          <p class="text-[14px]">小班制團體訓練，肌力、肌耐力、有氧心肺，提供不同訓練類型。</p>
        </li>
      </ul>
    </div>
    <%- require('@component/mBtn.ejs')({
        label: '課程項目',
        link: './service.html',
        style: {
          main: '--border p:flex-shrink-0 p:self-end p:text-[18px] p:w-[244px] p:h-[45px] tm:mx-auto tm:w-[205px] tm:h-[45px]',
          icon: 'w-[45px]'
        },
        icon: {
          name: 'arrow',
          css: 'p:w-[18px] p:h-[18px] tm:w-[24px] tm:h-[24px]'
        }
      }) %>
  </div>
</section>
