<%
  /* 與 header 共用同一份導覽資料，同樣在 build 期輸出成靜態 <a href> */
  const navItems = require('_data/nav.js');
  /* 社群連結同樣只有一份來源，避免 footer 與結構化資料各寫各的而不同步 */
  const social = require('_data/social.js');
  /* 地圖連結也用商家資料那一份（結構化資料的 hasMap），換地圖網址只要改一處 */
  const site = require('_data/site.js');
  const currentFile = typeof filename !== 'undefined' && filename ? filename : '';
  /* nav.js 存的是站內路徑，前面接上部署子目錄才是真正的網址 */
  const href = (url) => `${process.env.ROOT_DIRECTORY}${url}`;
  /*
   * 資料夾網址（例如 article/）實際的檔名是 article/index.html，
   * 比對前先把結尾的 index.html 拿掉，兩種寫法才對得上。
   */
  const isActive = (url) => url === currentFile.replace(/index\.html$/, '');
-%>
<footer class="m-ft p:px-[50px] p:pt-[50px] tm:px-[40px] tm:pt-[30px]">
  <div class="p:flex p:justify-between p:pl-[30px]">
    <div data-aos="fade-right" class="tm:flex tm:flex-col tm:items-center p:w-[270px] t:w-[500px] tm:mx-auto tm:mb-[50px]">
      <div class="m-hd-logo p:inline-block m:flex m:items-center p:mb-[18px] tm:mb-[16px]">
        <%- require('@component/svg.ejs')({
          svgName: 'logo_sub',
          style: {
            main: 'text-[var(--white)] p:w-[260px] p:h-[55px] t:w-[216px] t:h-[60px] m:w-[180px] m:h-[50px]'
          }
        }) %>
        <em class="sr-only">
          <%- process.env.PROJECT_NAME %>
        </em>
      </div>
      <p class="tm:text-center p:text-[12px] t:text-[20px] m:text-[14px] p:mb-[22px] tm:mb-[30px]">
        追蹤我們的社群媒體，每週都會有實質的內容與教學，降低更多的運動傷害，讓我們同步更好的訓練效益！</p>
      <%- require('@component/mBtn.ejs')({
        label: '即刻預約',
        link: `${process.env.ROOT_DIRECTORY}contact.html`,
        style: {
          main: '--border w-full'
        }
      }) %>
    </div>
    <div data-aos="fade-in">
      <ul class="flex tm:flex-wrap">
        <li class="p:mx-[40px] tm:w-1/2">
          <h2 class="text-[var(--xc7)] font-bold p:mb-[8px] tm:mb-[6px] p:text-[20px] tm:text-[20px]">網站導覽</h2>
          <ul>
            <% navItems.forEach((item) => { -%>
            <li>
              <a href="<%= href(item.url) %>" class="pt:text-[14px] m:text-[12px]"
                <%- isActive(item.url) ? ' aria-current="page"' : '' %>><%= item.label %></a>
            </li>
            <% }); -%>
          </ul>
        </li>
        <li class="p:mx-[40px] tm:w-1/2">
          <h2 class="text-[var(--xc7)] font-bold p:mb-[8px] tm:mb-[6px] p:text-[20px] tm:text-[20px]">社群媒體</h2>
          <ul>
            <% social.forEach((item) => { -%>
            <li>
              <%/* 社群是完整外部網址，不要接部署子目錄 */%>
              <a href="<%= item.url %>" class="pt:text-[14px] m:text-[12px]" target="_blank" rel="noopener">
                <%- require('svg.ejs')({
                  svgName: item.icon,
                  style: {
                    main: 'inline w-[16px] h-[16px] text-[var(--xc7)]'
                  }
                }) %>
                <%= item.label %>
              </a>
            </li>
            <% }); -%>
          </ul>
        </li>
        <li class="p:mx-[40px] tm:w-full tm:mt-[20px]">
          <ul class="tm:flex">
            <li class="tm:w-1/2">
              <h2 class="text-[var(--xc7)] font-bold p:mb-[8px] tm:mb-[6px] p:text-[20px] tm:text-[20px]">營業時間</h2>
              <p class="pt:text-[14px] m:text-[12px]">週一至週六（周日公休）</p>
              <p class="pt:text-[14px] m:text-[12px]">下午 01 : 00 ~<br class="p:hidden"> 晚上 10 : 00</p>
            </li>
            <li class="p:mt-[40px] tm:w-1/2">
              <h2 class="text-[var(--xc7)] font-bold p:mb-[8px] tm:mb-[6px] p:text-[20px] tm:text-[20px]">地址電話</h2>
              <%/*
                電話也加同一個 ↗，跟下面的地址統一 —— 兩個連結長得一樣，
                看的人才會推得出「有箭頭的都能點」。改用聽筒圖示的話，
                很容易被當成單純的裝飾。手機上點下去是直接撥號。
              */%>
              <a class="block p:mb-[4px] tm:mb-[10px] pt:text-[14px] m:text-[12px]" href="tel:+886-2-25222330">(02)2522-2330<%- require('@component/svg.ejs')({
                  svgName: 'arrow',
                  style: {
                    main: 'inline-block w-[0.9em] h-[0.9em] ml-[6px] -rotate-45 align-[-0.1em]'
                  }
                }) %><span class="sr-only">（撥打電話）</span></a>
              <%/*
                地址連到 Google 地圖的店家頁：手機上會直接開地圖 App，按「路線」就能導航。
                原本就有連結，但跟電話一樣是純文字的樣子，看不出能點 ——
                地址後面加一個指向右上的箭頭（↗，「開到別的地方」的慣用符號）。
                不用底線：兩行地址都畫線太吵。

                箭頭沿用站上的 arrow.svg 轉 -45 度，跟其他按鈕的箭頭是同一個樣子。
                它是裝飾，意思由 sr-only 那句講給螢幕閱讀器聽。
              */%>
              <a class="m-ft-map pt:text-[14px] m:text-[12px]" href="<%= site.hasMap %>" target="_blank" rel="noopener">
                <span class="block leading-tight">
                  10449<br>台北市中山區中山北路二段128巷32號1F<%- require('@component/svg.ejs')({
                    svgName: 'arrow',
                    style: {
                      main: 'inline-block w-[0.9em] h-[0.9em] ml-[6px] -rotate-45 align-[-0.1em]'
                    }
                  }) %><span class="sr-only">（在 Google 地圖開啟）</span>
                </span>
              </a>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
  <small class="m-ft-copyright block py-[24px] text-center text-[13px] m:px-[20px]">
    <%- process.env.COPYRIGHT %>
  </small>
</footer>
