<%/* 學員成績與評價：五星好評、InBody、體態改善 */%>
<% const resevation = require('_data/resevation.js'); -%>
<% const site = require('_data/site.js'); -%>
<!-- 學員評價&成績 -->
<%/*
  淡入掛在內容上，不掛在 section 上。
  這一塊沿用上一塊的底色、而且刻意沒有 padding-top，
  底色若跟著淡入，半透明時會比上一塊暗，就在標題正上方切出一條橫邊。
*/%>
<section class="p:pb-[90px] t:pb-[75px] m:pb-[50px] bg-[var(--x15)] text-[var(--white)]">
  <h2 data-aos="fade-in" class="resevation-h1 deco-header p:mb-[70px] t:mb-[40px] m:mb-[40px]">學員評價</h2>
  <div data-aos="fade-in" class="p:max-w-[1220px] pt:mx-auto">
    <%- require('@component/mReviewList.ejs')({ controls: true }) %>

    <p class="text-center p:mt-[50px] tm:mt-[42px]">
      <a href="<%= site.hasMap %>" target="_blank" rel="noopener"
        class="inline-flex items-center border-b border-solid border-[rgb(255_255_255_/_45%)] pb-[6px] p:text-[15px] tm:text-[14px] hover:border-[var(--white)] transition-colors duration-300 ease-in-out">
        查看所有 Google 評論
        <%- require('@component/svg.ejs')({
          svgName: 'arrow',
          style: { main: 'w-[18px] h-[18px] ml-[16px]' }
        }) %>
      </a>
    </p>
  </div>
</section>
