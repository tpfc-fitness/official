<%/* 福利與待遇 */%>
<section class="text-[var(--white)] bg-[var(--black)] p:px-[60px] p:py-[110px] t:p-[50px] m:p-[30px]">
  <div data-aos="fade-up" class="p:flex p:w-[900px] p:mx-auto">
    <%- require('img.ejs')({
      path: require('@imgs/service/firstclass_fitness_equipment.jpeg'),
      alt : '健身訓練器材',
      style: {
        main: 'p:flex-shrink-0 p:mr-[70px] p:w-[363px] p:h-[363px]',
        img: 'object-cover object-center'
      }
    }) %>
    <div class="flex-grow t:mt-[24px] m:mt-[10px]">
      <h3 class="font-bold p:text-[40px] tm:text-[30px] p:mb-[20px] tm:mb-[16px]">福利與待遇</h3>
      <div>
        <p class="p:text-[16px] t:text-[18px]">我們會依照你的能力訂定目標，讓整個團隊不斷成長，<br class="p:hidden"/>當你達到當月目標，便可擁有...</p>
        <p class="p:text-[16px] t:text-[18px]"><b class="ani-special p:text-[32px] t:text-[48px] m:text-[32px]">『自由班』</b>和學生有約再來，掌控個人時間</p>
      </div>
      <div class="p:mt-[24px] tm:mt-[18px]">
        <p class="p:text-[16px] t:text-[18px]">沒有任何經驗或是背景怎麼辦 ?<br>不用擔心！<br class="p:hidden"/>我們擁有多年的教學經驗，能提供你完整的健身教練培訓計畫，在這裡你能學到：</p>
        <ul class="flex items-center m:flex-wrap p:space-x-[36px] p:mt-[18px] t:mt-[24px] m:mt-[18px] text-center m:px-[20px] m:space-y-[12px]">
          <li class="t:w-1/4 m:w-1/2">
            <%- require('@component/svg.ejs')({
              svgName: 'icon_revenue',
              style: {
                main: 'mx-auto text-[var(--white)] p:w-[48px] p:h-[48px] t:w-[108px] m:w-[60px] t:h-[108px] m:h-[54px] order-1'
              }
            }) %>
            <h4 class="p:text-[14px] t:text-[18px] m:text-[14px] p:mt-[4px] m:mt-[4px] t:mt-[12px]">銷售技巧</h4>
          </li>
          <li class="t:w-1/4 m:w-1/2">
            <%- require('@component/svg.ejs')({
              svgName: 'icon_muscle',
              style: {
                main: 'mx-auto text-[var(--white)] p:w-[48px] p:h-[48px] t:w-[120px] m:w-[60px] t:h-[108px] m:h-[54px] order-1'
              }
            }) %>
            <h4 class="p:text-[14px] t:text-[18px] m:text-[14px] p:mt-[4px] m:mt-[4px] t:mt-[12px]">專業知識進修</h4>
          </li>
          <li class="t:w-1/4 m:w-1/2">
            <%- require('@component/svg.ejs')({
              svgName: 'icon_management',
              style: {
                main: 'mx-auto text-[var(--white)] p:w-[48px] p:h-[48px] t:w-[120px] m:w-[60px] t:h-[108px] m:h-[54px] order-1'
              }
            }) %>
            <h4 class="p:text-[14px] t:text-[18px] m:text-[14px] p:mt-[4px] m:mt-[4px] t:mt-[12px]">人際關係與溝通</h4>
          </li>
          <li class="t:w-1/4 m:w-1/2">
            <%- require('@component/svg.ejs')({
              svgName: 'icon_social_media',
              style: {
                main: 'mx-auto text-[var(--white)] p:w-[48px] p:h-[48px] t:w-[120px] m:w-[60px] t:h-[108px] m:h-[54px] order-1'
              }
            }) %>
            <h4 class="p:text-[14px] t:text-[18px] m:text-[14px] p:mt-[4px] m:mt-[4px] t:mt-[12px]">自媒體行銷</h4>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
