<%/* 一對一還是一對二？ */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-bg-photo 與 _modules/m-service，
   *    使用的頁面樣式表必須引入它們。
   *
   * ⚠️ 一大一小不是排版偏好，是立場：一對一佔 3/5、帶「建議從這裡開始」
   *    標記，一對二佔 2/5。兩張等寬會讓一對二看起來是同等推薦的選項。
   */
  const { courses } = require('_data/service.js');
  const SPANS = ['p:col-span-3', 'p:col-span-2'];
-%>
<section
  class="text-[var(--white)] bg-[var(--black)] p:px-[60px] p:py-[90px] t:px-[40px] t:py-[64px] m:px-[20px] m:py-[44px]">
  <div class="p:max-w-[1200px] p:mx-auto">
    <header data-aos="fade-up">
      <p class="m-sec-eyebrow"><%= courses.eyebrow %></p>
      <h2 class="resevation-h1 p:mt-[14px] tm:mt-[10px]"><%= courses.title %></h2>
      <p class="leading-[1.9] p:mt-[18px] tm:mt-[12px] p:max-w-[860px] p:text-[16px] tm:text-[14px] text-[var(--xc7)]">
        <%= courses.lead %></p>
    </header>

    <div class="grid p:mt-[48px] t:mt-[36px] m:mt-[24px] p:grid-cols-5 p:gap-[28px] tm:grid-cols-1 tm:gap-[20px]">
      <% courses.items.forEach((item, idx) => { -%>
      <article data-aos="fade-up"
        class="m-bg-photo --card relative overflow-hidden <%= SPANS[idx] %> p:p-[44px] t:p-[32px] m:p-[24px]">
        <%- require('img.ejs')({
          path: item.img,
          alt: item.alt,
          style: {
            main: 'm-bg-photo-img',
            img: 'object-cover object-center'
          }
        }) %>

        <div class="relative z-[1]">
          <p class="flex flex-wrap items-center p:gap-[14px] tm:gap-[10px]">
            <b class="font-black leading-none text-[var(--xe120)] p:text-[40px] t:text-[34px] m:text-[30px]">
              <%= item.no %></b>
            <% if (item.badge) { -%>
            <span class="m-card-badge"><%= item.badge %></span>
            <% } -%>
          </p>
          <h3 class="font-bold leading-[1.3] p:mt-[14px] tm:mt-[10px] p:text-[28px] t:text-[24px] m:text-[21px]">
            <%= item.name %></h3>
          <p class="font-bold leading-[1.6] p:mt-[16px] tm:mt-[12px] p:text-[16px] tm:text-[15px]">
            <%= item.lead %></p>
          <i class="block h-px bg-[var(--x56)] p:my-[18px] tm:my-[14px]"></i>
          <p class="leading-[1.9] p:text-[14px] tm:text-[13px] text-[var(--xc7)]"><%= item.body %></p>
        </div>
      </article>
      <% }); -%>
    </div>
  </div>
</section>
