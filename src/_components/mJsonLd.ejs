<%
  /*
   * 結構化資料（JSON-LD）
   * - HealthClub：本地商家實體（LocalBusiness 的子型別），
   *   讓 Google 認得地址、電話、營業時間、價格與課程方案
   * - WebSite：網站實體，與商家實體以 @id 互相關聯
   * - BreadcrumbList：內頁麵包屑，改善搜尋結果的路徑顯示
   * - WebPage + Service：只有服務項目頁輸出，把「一對一私人教練」
   *   本身宣告成一個可被引用的服務實體（含價格），而不是只讓它
   *   混在商家的 hasOfferCatalog 裡
   * - FAQPage：只有 faq 頁輸出。Google 從 2023 起不再給一般網站
   *   FAQ 複合式搜尋結果，但生成式搜尋與 LLM 的爬蟲會讀 JSON-LD，
   *   所以對 AEO 仍然值得輸出。
   *
   * ⚠️ 全站只有一頁該宣告 FAQPage。contact 頁也有問答，但那是給
   *    已經要填表的人看的，兩頁都宣告會變成自己跟自己競爭同一組查詢。
   *
   * 三者以 @id 錨定，Google 會跨頁去重，所以可以每頁都輸出。
   */
  const site = require('_data/site.js');
  const offers = require('_data/offers.js');
  const siteUrl = typeof SITE_URL !== 'undefined' ? SITE_URL : '';
  const pageUrl = typeof PAGE_URL !== 'undefined' ? PAGE_URL : siteUrl;
  const pageTitle = typeof PAGE_TITLE !== 'undefined' ? PAGE_TITLE : '';
  const isHome = typeof IS_HOME !== 'undefined' ? IS_HOME : false;
  const isService = typeof IS_SERVICE !== 'undefined' ? IS_SERVICE : false;

  const orgId = `${siteUrl}/#organization`;
  const siteId = `${siteUrl}/#website`;

  /*
   * 一筆 offers.js 的資料 → 一個 schema.org 的 Offer。
   * 有級距的用 UnitPriceSpecification 標出上下限，定價的直接給 price。
   */
  const toOffer = (offer) => ({
    '@type': 'Offer',
    name: offer.name,
    description: offer.description,
    itemOffered: {
      '@type': 'Service',
      name: offer.name,
      provider: { '@id': orgId },
    },
    ...(offer.price !== undefined
      ? { price: String(offer.price), priceCurrency: 'TWD' }
      : {
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            priceCurrency: 'TWD',
            minPrice: offer.minPrice,
            maxPrice: offer.maxPrice,
            unitText: offer.unitText,
          },
        }),
  });

  const graph = [
    {
      '@type': 'HealthClub',
      '@id': orgId,
      name: site.name,
      alternateName: site.alternateName,
      description: site.description,
      url: `${siteUrl}/`,
      telephone: site.telephone,
      email: site.email,
      image: `${siteUrl}/static/img/FB_share.png`,
      /* 品牌標是白色的，透明底在搜尋結果的白底上會整個看不見，所以保留深色底 */
      logo: `${siteUrl}/static/img/logo.png`,
      hasMap: site.hasMap,
      areaServed: {
        '@type': 'City',
        name: site.address.addressRegion,
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.streetAddress,
        addressLocality: site.address.addressLocality,
        addressRegion: site.address.addressRegion,
        postalCode: site.address.postalCode,
        addressCountry: site.address.addressCountry,
      },
      openingHoursSpecification: site.openingHours.map((item) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: item.dayOfWeek,
        opens: item.opens,
        closes: item.closes,
      })),
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      sameAs: site.sameAs,
      /*
       * 課程與價格。把價格變成機器讀得懂的資料 —— 生成式搜尋回答
       * 「台北中山區私人教練多少錢」時才引用得到，而不是只能從
       * 內文猜。有級距的用 UnitPriceSpecification 標出上下限。
       */
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: '課程與方案',
        itemListElement: offers.map(toOffer),
      },
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: `${siteUrl}/`,
      name: site.alternateName,
      inLanguage: 'zh-Hant-TW',
      publisher: { '@id': orgId },
    },
  ];

  /* 首頁本身就是麵包屑的根，不需要再輸出 */
  if (!isHome && pageTitle) {
    graph.push({
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '首頁',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageTitle,
          item: pageUrl,
        },
      ],
    });
  }

  /*
   * 服務項目頁：宣告這一頁在講哪一個服務。
   *
   * WebPage 的 about 指向 Service，breadcrumb 指向上面已產生的
   * 麵包屑 —— 三個節點在同一個 @graph 裡，不另開 <script>。
   *
   * Service 的價格直接引用 offers.js，與首頁的 hasOfferCatalog
   * 是同一組數字。一對二仍然列出（它確實有提供），但不進 name。
   */
  if (isService) {
    const PT_OFFER_NAMES = [
      '新生 10 堂訓練計畫',
      '新生 10 堂訓練計畫（一對二）',
      '一對一私人教練課',
      '一對二私人教練課',
    ];
    const serviceId = `${pageUrl}#personal-training`;

    graph.push({
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': siteId },
      about: { '@id': serviceId },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    });

    graph.push({
      '@type': 'Service',
      '@id': serviceId,
      name: '一對一私人教練',
      serviceType: '私人教練',
      provider: { '@id': orgId },
      areaServed: '台北市中山區',
      offers: PT_OFFER_NAMES.map((name) => toOffer(offers.find((o) => o.name === name))),
    });
  }

  /* 常見問題頁：把問答輸出成 FAQPage */
  if (typeof IS_FAQ !== 'undefined' && IS_FAQ) {
    const faq = require('_data/faq.js');

    graph.push({
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faq.flatMap((group) =>
        group.items.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            /*
             * 攤平成純文字：結構化資料不吃標籤，清單改成一行一項
             * 加上頓號，這樣被摘錄時仍讀得出是並列的項目。
             */
            text: item.a
              .map((line) => (line.list ? line.list.map((li) => `・${li}`).join('\n') : line))
              .join('\n')
              .replace(/<[^>]+>/g, ''),
          },
        })),
      ),
    });
  }

  /* 把 < 轉義，避免內容裡出現 </script 提早關閉標籤 */
  const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
    .replace(/</g, '\\u003c');
-%>
<script type="application/ld+json">
  <%- json %>

</script>
