<%
  /*
   * 結構化資料（JSON-LD）
   * - HealthClub：本地商家實體，讓 Google 認得地址、電話、營業時間、社群帳號
   * - WebSite：網站實體，與商家實體以 @id 互相關聯
   * - BreadcrumbList：內頁麵包屑，改善搜尋結果的路徑顯示
   *
   * 三者以 @id 錨定，Google 會跨頁去重，所以可以每頁都輸出。
   */
  const site = require('_data/site.js');
  const siteUrl = typeof SITE_URL !== 'undefined' ? SITE_URL : '';
  const pageUrl = typeof PAGE_URL !== 'undefined' ? PAGE_URL : siteUrl;
  const pageTitle = typeof PAGE_TITLE !== 'undefined' ? PAGE_TITLE : '';
  const isHome = typeof IS_HOME !== 'undefined' ? IS_HOME : false;

  const orgId = `${siteUrl}/#organization`;
  const siteId = `${siteUrl}/#website`;

  const graph = [
    {
      '@type': 'HealthClub',
      '@id': orgId,
      name: site.name,
      alternateName: site.alternateName,
      description: site.description,
      url: `${siteUrl}/`,
      telephone: site.telephone,
      email: site.email,
      image: `${siteUrl}/static/img/FB_share.png`,
      hasMap: site.hasMap,
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.streetAddress,
        addressLocality: site.address.addressLocality,
        addressRegion: site.address.addressRegion,
        postalCode: site.address.postalCode,
        addressCountry: site.address.addressCountry,
      },
      openingHoursSpecification: site.openingHours.map((item) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: item.dayOfWeek,
        opens: item.opens,
        closes: item.closes,
      })),
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      sameAs: site.sameAs,
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: `${siteUrl}/`,
      name: site.alternateName,
      inLanguage: 'zh-Hant-TW',
      publisher: { '@id': orgId },
    },
  ];

  /* 首頁本身就是麵包屑的根，不需要再輸出 */
  if (!isHome && pageTitle) {
    graph.push({
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: '首頁',
          item: `${siteUrl}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: pageTitle,
          item: pageUrl,
        },
      ],
    });
  }

  /* 把 < 轉義，避免內容裡出現 </script 提早關閉標籤 */
  const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
    .replace(/</g, '\\u003c');
-%>
<script type="application/ld+json"><%- json %></script>
