<%/* 頭等倉教練的訓練方針 */%>
<% const rules = require('_data/training-rules.js'); -%>
<!-- 訓練方針 -->
<section data-aos="fade-in" class="text-[var(--white)] p:pt-[90px] p:pb-[120px] t:py-[75px] m:py-[40px]">
  <header class="text-center p:pb-[70px] t:pb-[56px] m:pb-[40px] p:px-[60px] t:px-[40px] m:px-[20px]">
    <h2 class="resevation-h1"><%= rules.title %></h2>
    <p class="resevation-p p:mt-[18px] tm:mt-[12px] p:max-w-[56ch] pt:mx-auto"><%= rules.lead %></p>
  </header>
  <div class="m-slider pt:mx-auto p:max-w-[1220px] pt:mb-[40px] m:mb-[28px]">
    <ul class="training-rules-slider pt:flex">
      <% rules.items.forEach((item) => { -%>
      <li class="p:w-1/4 tm:min-h-[340px]">
        <div
          class="bg-[#fff] text-[var(--black)] h-full p:mx-[10px] p:px-[24px] p:py-[32px] t:px-[20px] t:py-[28px] m:px-[24px] m:py-[32px]">
          <p class="training-rule-no"><%= item.no %></p>
          <h3 class="resevation-h3 deco-line p:mt-[14px] tm:mt-[12px]"><%= item.title %></h3>
          <%/* 反話要和正面敘述分開，不然會被連著讀成同一句 */%>
          <p class="training-rule-contrast p:mt-[22px] tm:mt-[18px]"><%= item.contrast %></p>
          <p class="resevation-p p:mt-[10px] tm:mt-[8px]"><%= item.body %></p>
        </div>
      </li>
      <% }); -%>
    </ul>
    <div class="m-slider-ctrl training-rules-slider-ctrl p:hidden">
      <button type="button" class="m-slider-prev">
        <span class="sr-only">上一張</span>
      </button>
      <button type="button" class="m-slider-next">
        <span class="sr-only">下一張</span>
      </button>
    </div>
  </div>
  <p class="text-[#fff] text-center pt:mb-[50px] m:mb-[20px] m:px-[12px]">
    或許你已經努力過了好幾次<br>但有可能只是方式不對<br><br>我們已經幫助百位學員成功蛻變、重拾自信<br>他們也和你一樣<br>只是一般的上班族，有家庭要顧、有工作要忙、也有吃美食的慾望<br>卻都在這裡找到了適合自己的訓練方式<br>輕鬆養成習慣、穩定看見成果<br><br>如果他們都能做到，你也一定可以！
  </p>
  <%- require('@component/mBtn.ejs')({
    label: '預約免費體驗課',
    link: undefined,
    type: 'button',
    func: 'scrollToResevation()',
    style: {
      main: '--highlight mx-auto p:text-[18px] text-[var(--white)] p:w-[270px] p:h-[50px] t:w-[216px] t:h-[60px] m:w-[220px] m:h-[56px]'
    }
  }) %>
</section>
