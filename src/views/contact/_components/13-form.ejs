<%/* 預約表單 */%>
<% const site = require('_data/site.js'); -%>
<!-- 預約表單 -->
<section id="resevation"
  class="contact-bd flex flex-col justify-center items-center text-[var(--white)] bg-[var(--x15)] p:px-[60px] p:py-[60px] t:px-[20px] t:py-[40px] m:pb-[20px]">
  <div data-aos="fade-in"
    class="bg-[var(--black)] p:p-[60px] p:min-w-[600px] p:min-h-[400px] p:max-w-[800px] text-center t:p-[30px] t:pb-[40px]">
    <div class="m:p-[20px]">
      <h2 class="resevation-title p:mb-[20px] t:mb-[14px]">
        預約免費體驗
      </h2>
      <%/*
        不想填表的人也要有路可走，LINE 是唯一的替代管道。

        不放 LINE 的圖示：這裡是一句話裡的行內連結，塞一個品牌標進去
        會變成句子中間卡一塊圖。滑過去也不換字色 —— 沿用站上其他
        行內連結的作法，只讓底線由半透明變實心。
      */%>
      <p class="resevation-p p:mb-[10px] tm:mb-[12px]">
        請填寫送出下方表單，<br class="pt:hidden" />或
        <a href="<%= site.line %>" target="_blank" rel="noopener"
          class="font-bold border-b border-solid border-[rgb(255_255_255_/_45%)] hover:border-[var(--white)] transition-colors duration-300 ease-in-out">點擊此處</a>
        使用 LINE 官方帳號預約
      </p>
      <i
        class="block border-[1px] border-solid border-[var(--white)] p:mt-[10px] p:mb-[20px] tm:mt-[16px] t:mb-[20px]"></i>
    </div>
