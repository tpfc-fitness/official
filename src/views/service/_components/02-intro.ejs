<%/* 導言：H1 與導言左右並排 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-service 的 .m-sec-eyebrow 與 .m-place，
   *    使用的頁面樣式表必須引入它。
   */
  const { hero } = require('_data/service.js');
-%>
<section
  class="text-[var(--white)] bg-[var(--black)] p:px-[60px] p:py-[80px] t:px-[40px] t:py-[56px] m:px-[20px] m:py-[40px]">
  <%/* 桌機左標題右說明，平板與手機堆疊 */%>
  <div class="p:max-w-[1200px] p:mx-auto p:flex p:items-start p:gap-[80px]">
    <div data-aos="fade-up" class="p:w-[46%] p:flex-shrink-0">
      <p class="m-sec-eyebrow"><%= hero.eyebrow %></p>
      <h1
        class="font-black leading-[1.25] tracking-[-0.03em] p:mt-[16px] tm:mt-[12px] p:text-[44px] t:text-[36px] m:text-[28px]">
        <%= hero.title %></h1>
    </div>

    <div data-aos="fade-up" class="p:flex-grow tm:mt-[24px]">
      <p class="leading-[1.9] p:text-[16px] tm:text-[14px] text-[var(--xc7)]"><%= hero.lead %></p>

      <%/* 地點與 CTA：桌機並排，手機堆疊 */%>
      <div class="p:flex p:items-center p:gap-[28px] p:mt-[32px] tm:mt-[24px]">
        <p class="m-place">
          <%- require('@component/svg.ejs')({
            svgName: 'icon_pin',
            style: { main: 'm-place-icon' }
          }) %>
          <span><%= hero.place %></span>
        </p>
        <%- require('@component/mBtn.ejs')({
          label: hero.cta.label,
          link: hero.cta.link,
          style: {
            main: '--highlight p:flex-shrink-0 tm:mt-[18px] p:w-[220px] p:h-[50px] tm:w-full tm:h-[48px] p:text-[16px] tm:text-[15px]',
            icon: 'w-[40px]'
          },
          icon: {
            name: 'arrow',
            css: 'w-[18px] h-[18px]'
          }
        }) %>
      </div>
    </div>
  </div>
</section>
