<%/* 教練場租 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-price-list，使用的頁面樣式表必須引入它。
   *
   * 沒有輪播 —— 這一段的內容是價格，不是要看的東西。
   * 前面三種課程各有一組照片可以帶氣氛，場租沒有，硬放照片只會變成
   * 「看起來像課程、其實在講租金」。
   */
  const rental = require('_data/rental.js');
-%>
<section data-aos="fade-in"
  class="text-center text-[var(--white)] bg-[var(--black)] p:px-[60px] p:pb-[100px] t:px-[40px] t:pb-[75px] m:px-[20px] m:pb-[50px]">
  <div class="p:max-w-[760px] pt:mx-auto">
    <p class="text-[11px] tracking-[0.24em] text-[var(--xe120)] font-bold">SPACE RENTAL</p>
    <h2 class="resevation-h1 p:mt-[14px] tm:mt-[10px]">教練場租</h2>

    <p class="leading-[1.9] p:mt-[24px] tm:mt-[16px] p:text-[16px] tm:text-[14px] text-[var(--xc7)]">
      <%= rental.lead %>詳細費用如下：
    </p>

    <ul class="p:mt-[20px] tm:mt-[14px] p:space-y-[4px] tm:space-y-[3px]">
      <% rental.notes.forEach((note) => { -%>
      <li class="m-price-list-note">＊<%= note %></li>
      <% }); -%>
    </ul>

    <%/* 表格本身靠左右對齊才讀得出配對，整塊再置中 */%>
    <dl class="m-price-list mx-auto p:mt-[36px] tm:mt-[26px]">
      <% rental.plans.forEach((plan) => { -%>
      <div>
        <dt>
          <%= plan.name %>
          <% if (plan.term) { -%>
          <span class="m-price-list-term"><%= plan.term %></span>
          <% } -%>
        </dt>
        <dd><%= plan.price %></dd>
      </div>
      <% }); -%>
    </dl>
  </div>
</section>
