<%
  /*
   * 結構化資料（JSON-LD）
   * - HealthClub：本地商家實體（LocalBusiness 的子型別），
   *   讓 Google 認得地址、電話、營業時間、價格與課程方案
   * - WebSite：網站實體，與商家實體以 @id 互相關聯
   * - BreadcrumbList：內頁麵包屑，改善搜尋結果的路徑顯示
   * - WebPage + Service：只有服務項目頁輸出，把「一對一私人教練」
   *   本身宣告成一個可被引用的服務實體（含價格），而不是只讓它
   *   混在商家的 hasOfferCatalog 裡
   * - CollectionPage + ItemList：只有健身知識（文章列表）頁輸出，
   *   告訴搜尋引擎這一頁是「一組文章的入口」，並逐篇列出網址與標題。
   * - Article：只有文章頁輸出。把標題、摘要、作者與更新日期變成
   *   機器讀得懂的資料，生成式搜尋引用時才知道這是誰寫的、什麼時候更新的。
   * - FAQPage：只有 faq 頁輸出。Google 從 2023 起不再給一般網站
   *   FAQ 複合式搜尋結果，但生成式搜尋與 LLM 的爬蟲會讀 JSON-LD，
   *   所以對 AEO 仍然值得輸出。
   *
   * ⚠️ 全站只有一頁該宣告 FAQPage。contact 頁也有問答，但那是給
   *    已經要填表的人看的，兩頁都宣告會變成自己跟自己競爭同一組查詢。
   *
   * 三者以 @id 錨定，Google 會跨頁去重，所以可以每頁都輸出。
   */
  const site = require('_data/site.js');
  const offers = require('_data/offers.js');
  const siteUrl = typeof SITE_URL !== 'undefined' ? SITE_URL : '';
  const pageUrl = typeof PAGE_URL !== 'undefined' ? PAGE_URL : siteUrl;
  const pageTitle = typeof PAGE_TITLE !== 'undefined' ? PAGE_TITLE : '';
  const isHome = typeof IS_HOME !== 'undefined' ? IS_HOME : false;
  const isService = typeof IS_SERVICE !== 'undefined' ? IS_SERVICE : false;
  const articleSlug = typeof ARTICLE_SLUG !== 'undefined' ? ARTICLE_SLUG : '';
  const isArticleIndex = typeof IS_ARTICLE_INDEX !== 'undefined' ? IS_ARTICLE_INDEX : false;

  /*
   * 健身知識（文章列表）的名稱與網址，從導覽資料取 ——
   * 選單上叫什麼，麵包屑就叫什麼，改名只要改 nav.js 一處。
   */
  const articleIndexNav = require('_data/nav.js').find((item) => item.url === 'article/');
  const articleIndex = {
    name: articleIndexNav ? articleIndexNav.label : '健身知識',
    url: `${siteUrl}/article/`,
  };
  const articleUrl = (slug) => `${siteUrl}/article/${slug}.html`;

  const orgId = `${siteUrl}/#organization`;
  const siteId = `${siteUrl}/#website`;

  /*
   * 一筆 offers.js 的資料 → 一個 schema.org 的 Offer。
   * 有級距的用 UnitPriceSpecification 標出上下限，定價的直接給 price。
   */
  const toOffer = (offer) => ({
    '@type': 'Offer',
    name: offer.name,
    description: offer.description,
    itemOffered: {
      '@type': 'Service',
      name: offer.name,
      provider: { '@id': orgId },
    },
    ...(offer.price !== undefined
      ? { price: String(offer.price), priceCurrency: 'TWD' }
      : {
          priceSpecification: {
            '@type': 'UnitPriceSpecification',
            priceCurrency: 'TWD',
            minPrice: offer.minPrice,
            maxPrice: offer.maxPrice,
            unitText: offer.unitText,
          },
        }),
  });

  const graph = [
    {
      '@type': 'HealthClub',
      '@id': orgId,
      name: site.name,
      alternateName: site.alternateName,
      description: site.description,
      url: `${siteUrl}/`,
      telephone: site.telephone,
      email: site.email,
      image: `${siteUrl}/static/img/FB_share.png`,
      /* 品牌標是白色的，透明底在搜尋結果的白底上會整個看不見，所以保留深色底 */
      logo: `${siteUrl}/static/img/logo.png`,
      hasMap: site.hasMap,
      areaServed: {
        '@type': 'City',
        name: site.address.addressRegion,
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.streetAddress,
        addressLocality: site.address.addressLocality,
        addressRegion: site.address.addressRegion,
        postalCode: site.address.postalCode,
        addressCountry: site.address.addressCountry,
      },
      openingHoursSpecification: site.openingHours.map((item) => ({
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: item.dayOfWeek,
        opens: item.opens,
        closes: item.closes,
      })),
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.geo.latitude,
        longitude: site.geo.longitude,
      },
      sameAs: site.sameAs,
      /*
       * 課程與價格。把價格變成機器讀得懂的資料 —— 生成式搜尋回答
       * 「台北中山區私人教練多少錢」時才引用得到，而不是只能從
       * 內文猜。有級距的用 UnitPriceSpecification 標出上下限。
       */
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: '課程與方案',
        itemListElement: offers.map(toOffer),
      },
    },
    {
      '@type': 'WebSite',
      '@id': siteId,
      url: `${siteUrl}/`,
      /* 這裡只能給一個字串，不能用 alternateName —— 那是別名清單（陣列） */
      name: site.fullName,
      inLanguage: 'zh-Hant-TW',
      publisher: { '@id': orgId },
    },
  ];

  /*
   * 首頁本身就是麵包屑的根，不需要再輸出。
   *
   * 文章頁多一層「健身知識」：首頁 › 健身知識 › 文章標題。
   * 列表頁自己那一層用短名稱（健身知識），不用頁面的完整 title ——
   * 麵包屑會顯示在搜尋結果的網址列，太長會被截掉。
   */
  if (!isHome && pageTitle) {
    const trail = [{ name: '首頁', item: `${siteUrl}/` }];

    if (articleSlug) trail.push(articleIndex);
    trail.push(isArticleIndex ? articleIndex : { name: pageTitle, item: pageUrl });

    graph.push({
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: trail.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        item: crumb.item || crumb.url,
      })),
    });
  }

  /*
   * 健身知識（文章列表）：CollectionPage + ItemList。
   *
   * 每一篇用 @id 指向文章頁自己輸出的 Article 節點（同一個 #article 錨點），
   * 搜尋引擎會把兩邊認成同一篇，不會當成兩份重複的資料。
   */
  if (isArticleIndex) {
    const articles = require('_data/articles.js');

    graph.push({
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: articleIndex.name,
      description: typeof DESCRIPTION !== 'undefined' ? DESCRIPTION : undefined,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': siteId },
      publisher: { '@id': orgId },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
      ...(articles.length ? { dateModified: articles[0].updated } : {}),
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: articles.length,
        itemListElement: articles.map((article, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          item: {
            '@type': 'Article',
            '@id': `${articleUrl(article.slug)}#article`,
            url: articleUrl(article.slug),
            headline: article.title,
            description: article.description,
            articleSection: article.category,
            dateModified: article.updated,
            author: { '@type': 'Person', name: article.author.name },
          },
        })),
      },
    });
  }

  /*
   * 服務項目頁：宣告這一頁在講哪一個服務。
   *
   * WebPage 的 about 指向 Service，breadcrumb 指向上面已產生的
   * 麵包屑 —— 三個節點在同一個 @graph 裡，不另開 <script>。
   *
   * Service 的價格直接引用 offers.js，與首頁的 hasOfferCatalog
   * 是同一組數字。一對二仍然列出（它確實有提供），但不進 name。
   *
   * PT_OFFER_NAMES 跟頁面上「價格方案」列的方案對齊：用 name 完全比對，
   * 所以 offers.js 改了 name 這裡也要改，不然 find 會拿到 undefined 而讓 build 失敗。
   */
  if (isService) {
    const PT_OFFER_NAMES = [
      '新生 10 堂訓練計畫',
      '新手組合 10＋8 堂',
      '新生 10 堂訓練計畫（一對二）',
      '16＋1 堂',
      '32＋2 堂',
      '48＋3 堂',
      '一對一私人教練課',
      '一對二私人教練課',
    ];
    const serviceId = `${pageUrl}#personal-training`;

    graph.push({
      '@type': 'WebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: pageTitle,
      inLanguage: 'zh-Hant-TW',
      isPartOf: { '@id': siteId },
      about: { '@id': serviceId },
      breadcrumb: { '@id': `${pageUrl}#breadcrumb` },
    });

    graph.push({
      '@type': 'Service',
      '@id': serviceId,
      name: '一對一私人教練',
      serviceType: '私人教練',
      provider: { '@id': orgId },
      areaServed: '台北市中山區',
      offers: PT_OFFER_NAMES.map((name) => toOffer(offers.find((o) => o.name === name))),
    });
  }

  /*
   * 文章頁：輸出 Article。
   *
   * 用 Article 不用 BlogPosting —— 這些是教學性質的內容，不是日誌；
   * 兩者對 Google 的效果相同，但 Article 比較不會讓人誤會網站有在寫部落格日記。
   *
   * dateModified 用資料裡的 updated；datePublished 沒有另外維護，
   * 先跟 updated 相同 —— 寧可少給一個欄位，也不要給一個編出來的日期。
   */
  if (articleSlug) {
    const articles = require('_data/articles.js');
    const article = articles.find((item) => item.slug === articleSlug);

    if (article) {
      graph.push({
        '@type': 'Article',
        '@id': `${pageUrl}#article`,
        headline: article.title,
        description: article.description,
        articleSection: article.category,
        inLanguage: 'zh-Hant-TW',
        datePublished: article.updated,
        dateModified: article.updated,
        author: {
          '@type': 'Person',
          name: article.author.name,
          jobTitle: article.author.role,
          worksFor: { '@id': orgId },
        },
        publisher: { '@id': orgId },
        /* 屬於健身知識這個欄目，而不只是屬於整個網站 */
        isPartOf: { '@id': `${articleIndex.url}#webpage` },
        mainEntityOfPage: pageUrl,
      });
    }
  }

  /* 常見問題頁：把問答輸出成 FAQPage */
  if (typeof IS_FAQ !== 'undefined' && IS_FAQ) {
    const faq = require('_data/faq.js');

    graph.push({
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faq.flatMap((group) =>
        group.items.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: {
            '@type': 'Answer',
            /*
             * 攤平成純文字：結構化資料不吃標籤，清單改成一行一項
             * 加上頓號，這樣被摘錄時仍讀得出是並列的項目。
             * 表格同理，一列一行，寫成「・方案：說明」。
             */
            text: item.a
              .map((line) => {
                if (line.list) return line.list.map((li) => `・${li}`).join('\n');
                if (line.table) return line.table.rows.map(([th, ...tds]) => `・${th}：${tds.join('　')}`).join('\n');
                return line;
              })
              .join('\n')
              .replace(/<[^>]+>/g, ''),
          },
        })),
      ),
    });
  }

  /* 把 < 轉義，避免內容裡出現 </script 提早關閉標籤 */
  const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
    .replace(/</g, '\\u003c');
-%>
<script type="application/ld+json">
  <%- json %>

</script>
