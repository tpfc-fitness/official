<%/* 新生優惠方案介紹 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-plan，使用的頁面樣式表必須引入它。
   */
  const plan = require('_data/newbie-plan.js');
-%>
<!-- 過度 -->
<div class="resevation-bg-03 text-center pt:py-[90px] m:py-[60px] m:px-[20px]">
  <p class="resevation-p text-[var(--black)]">
    進步快慢，<br />
    往往不是取決於你多努力，<br />
    而是<b>方向有沒有走對</b><br /><br />
    透過<b>一對一教練</b>協助，<br />
    能把有限的訓練時間，<br />
    用在真正對你有效的地方
  </p>
</div>

<!-- 新生 10 堂訓練計畫：方案與價格 -->
<section data-aos="fade-in"
  class="text-[var(--white)] bg-[var(--black)] p:pt-[100px] p:pb-[80px] t:pt-[75px] t:pb-[60px] m:pt-[50px] m:pb-[40px] p:px-[60px] t:px-[40px] m:px-[20px]">
  <div class="p:max-w-[1220px] pt:mx-auto">
    <h2 class="resevation-h1"><%= plan.title %></h2>
    <p class="resevation-h4 text-[var(--x7de9)] p:mt-[14px] tm:mt-[10px]"><%= plan.lead %></p>

    <div class="p:mt-[30px] tm:mt-[20px] p:max-w-[760px] p:space-y-[12px] tm:space-y-[10px]">
      <% plan.intro.forEach((line) => { -%>
      <p class="leading-[1.9] p:text-[16px] tm:text-[14px] text-[var(--xc7)]"><%- line %></p>
      <% }); -%>
    </div>

    <div class="m-plan-price p:mt-[50px] tm:mt-[32px]">
      <div>
        <p class="font-bold p:text-[18px] tm:text-[16px]"><%= plan.price.name %></p>
        <p class="flex items-baseline p:mt-[8px] tm:mt-[6px] p:gap-[8px] tm:gap-[6px]">
          <span class="m-plan-currency"><%= plan.price.currency %></span>
          <span class="m-plan-amount"><%= plan.price.amount %></span>
        </p>
        <p class="text-[var(--xc7)] p:mt-[8px] tm:mt-[6px] p:text-[15px] tm:text-[13px]"><%= plan.price.average %></p>

        <%- require('@component/mBtn.ejs')({
          label: plan.cta.label,
          link: plan.cta.link,
          style: {
            main: '--highlight p:mt-[24px] tm:mt-[18px] p:w-[236px] p:h-[52px] tm:w-full tm:h-[48px] p:text-[16px] tm:text-[15px]',
            icon: 'w-[40px]'
          },
          icon: {
            name: 'arrow',
            css: 'w-[18px] h-[18px]'
          }
        }) %>
      </div>

      <ul class="m-plan-tags">
        <% plan.price.tags.forEach((tag) => { -%>
        <li>
          <%- require('@component/svg.ejs')({
            svgName: tag.icon,
            style: { main: 'm-plan-tag-icon' }
          }) %>
          <span><%= tag.label %></span>
        </li>
        <% }); -%>
      </ul>
    </div>
  </div>
</section>

<!-- 10 堂課會帶走的四種能力 -->
<section data-aos="fade-in"
  class="text-[var(--white)] bg-[var(--x15)] p:py-[100px] t:py-[75px] m:py-[50px] p:px-[60px] t:px-[40px] m:px-[20px]">
  <div class="p:max-w-[1220px] pt:mx-auto">
    <h2 class="resevation-h1 deco-header p:mb-[60px] tm:mb-[36px]"><%= plan.abilitiesTitle %></h2>

    <ul class="m-plan-grid">
      <% plan.abilities.forEach((item) => { -%>
      <li class="m-plan-card" data-aos="fade-up">
        <p class="m-plan-no"><%= item.no %></p>
        <h3 class="font-bold leading-[1.4] p:mt-[10px] tm:mt-[6px] p:text-[24px] t:text-[20px] m:text-[18px]">
          <%= item.title %>
        </h3>
        <p class="m-plan-turn p:mt-[12px] tm:mt-[8px]"><%= item.turn %></p>

        <p class="leading-[1.9] p:mt-[20px] tm:mt-[14px] p:text-[15px] tm:text-[13px] text-[var(--xc7)]">
          <%= item.lead %>
        </p>

        <ul class="m-plan-keys p:mt-[14px] tm:mt-[10px]">
          <% item.keywords.forEach((key) => { -%>
          <li><%= key %></li>
          <% }); -%>
        </ul>

        <div class="p:mt-[20px] tm:mt-[14px] p:space-y-[10px] tm:space-y-[8px]">
          <% item.after.forEach((line) => { -%>
          <p class="leading-[1.9] p:text-[15px] tm:text-[13px] text-[var(--xc7)]"><%- line %></p>
          <% }); -%>
        </div>

        <% if (item.note) { -%>
        <p class="p:mt-[16px] tm:mt-[12px] p:text-[13px] tm:text-[12px] text-[var(--x6)]"><%= item.note %></p>
        <% } -%>
      </li>
      <% }); -%>
    </ul>
  </div>
</section>

<!-- 課堂之外 -->
<%/* 場館照當底，壓暗與裁切由 _modules/m-bg-photo 的 --bonus 負責 */%>
<section data-aos="fade-in"
  class="m-bg-photo --bonus relative overflow-hidden text-[var(--white)] p:pt-[100px] p:pb-[120px] t:pt-[75px] t:pb-[90px] m:pt-[50px] m:pb-[60px] p:px-[60px] t:px-[40px] m:px-[20px]">
  <div class="relative z-[1] p:max-w-[1220px] pt:mx-auto">
    <h2 class="resevation-h1 deco-header p:mb-[60px] tm:mb-[36px]"><%= plan.bonusTitle %></h2>

    <ul class="m-plan-bonus">
      <% plan.bonus.forEach((item) => { -%>
      <li data-aos="fade-up">
        <p class="m-plan-icon">
          <%- require('@component/svg.ejs')({
            svgName: item.icon,
            style: { main: 'm:w-[20px] m:h-[20px] pt:w-[24px] pt:h-[24px]' }
          }) %>
        </p>
        <h3 class="font-bold leading-[1.4] p:mt-[18px] tm:mt-[14px] p:text-[18px] tm:text-[16px]"><%= item.title %></h3>
        <p class="leading-[1.9] p:mt-[10px] tm:mt-[8px] p:text-[15px] tm:text-[13px] text-[var(--xc7)]">
          <%= item.body %>
        </p>
      </li>
      <% }); -%>
    </ul>

    <div
      class="text-center p:mt-[90px] t:mt-[70px] m:mt-[50px] p:pt-[60px] t:pt-[48px] m:pt-[40px] border-t border-solid border-[#fff] border-opacity-[0.12]">
      <p class="resevation-h3"><%= plan.closing.title %></p>
      <p class="text-[var(--xc7)] p:mt-[10px] tm:mt-[8px] p:text-[16px] tm:text-[14px]"><%= plan.closing.body %></p>

      <%- require('@component/mBtn.ejs')({
        label: plan.cta.label,
        link: plan.cta.link,
        style: {
          main: '--highlight mx-auto p:mt-[30px] tm:mt-[24px] p:w-[260px] p:h-[54px] t:w-[260px] t:h-[52px] m:w-full m:h-[48px] p:text-[17px] tm:text-[15px]',
          icon: 'w-[40px]'
        },
        icon: {
          name: 'arrow',
          css: 'w-[18px] h-[18px]'
        }
      }) %>
    </div>
  </div>
</section>
