<%
  const crypto = require('crypto');
  const FS = require('fs');
  const NODEPATH = require('path');
  const IMAGESIZE = require('image-size');
  const sizeOf = typeof IMAGESIZE === 'function' ? IMAGESIZE : IMAGESIZE.imageSize;

  /*
   * 讀出圖片的真實像素尺寸，供 width / height 屬性使用（修 CLS）。
   * webpack 產出的網址是 <publicPath>assets/img/<子資料夾>/foo.jpg?hash，
   * 對應的原始檔則在 src/assets/img/<子資料夾>/foo.jpg。
   * 任何一步失敗都回傳 null —— 寧可不輸出屬性，也不要輸出錯的尺寸。
   */
  const readSize = (url) => {
    try {
      const matched = /assets\/img\/[^?]+/.exec(String(url));
      if (!matched) return null;
      const abs = NODEPATH.join(process.env.PROJECT_ROOT, 'src', matched[0]);
      const { width, height } = sizeOf(FS.readFileSync(abs));
      return width && height ? { width, height } : null;
    } catch (err) {
      return null;
    }
  };

  const hash = length => {
    const btoa = crypto.createHash('md5').update((+new Date() + '')).digest('hex');
    return btoa.split('').reverse().slice(0, length).join('');
  };

  /* 傳進來的可能已經帶 ?hash，先切掉再自己接 */
  const rawPath = typeof path === 'object' ? path.p : path;
  const basePath = /.*(?=\?.*$)/.test(rawPath) ? /.*(?=\?.*$)/.exec(rawPath)[0] : rawPath;

  /*
   * WebpAssetsPlugin 會替每張 jpg / png 在同一層產出同名的 .webp，
   * 所以這裡不需要問「有沒有 webp」，換副檔名就是它的網址。
   *
   * ⚠️ 用的是 srcset 不是 data-srcset。
   * 原本那版寫 data-srcset，要等 vanilla-lazyload 在瀏覽器端換掉才生效 ——
   * 等於爬蟲、關掉 JS 的人、還有 eager 的首屏圖都吃不到 webp。
   * 靜態 srcset 由瀏覽器自己選，不需要 JS。
   */
  const isConvertible = /\.(jpe?g|png)$/i.test(basePath);
  const webpPath = isConvertible ? basePath.replace(/\.(jpe?g|png)$/i, '.webp') : null;

  /* 首屏圖片請傳 eager: true —— 立即載入並提高優先度，改善 LCP */
  const isEager = typeof eager !== 'undefined' && !!eager;

  /*
   * 純裝飾用的底圖請傳 decorative: true，輸出 alt=""。
   * 這類圖原本是 CSS background-image，對螢幕閱讀器來說一直是不存在的；
   * 改成 <img> 之後若給了描述性 alt，等於平白多念一句與內容無關的話。
   * 空 alt 才是正確做法：圖片被略過，該區塊的意義仍由文字承擔。
   */
  const isDecorative = typeof decorative !== 'undefined' && !!decorative;
  const altAttr = isDecorative
    ? 'alt=""'
    : `alt="${alt} | ${process.env.PROJECT_NAME}"`;

  /*
   * w-full h-full 取代原本 width="100%" height="100%" 這組 presentational hint。
   * 版面表現完全相同，但把 width / height 屬性空出來放真實像素，
   * 瀏覽器才算得出長寬比、在圖片載入前先保留位置（修 CLS）。
   */
  const imgClass = [
    typeof style !== 'undefined' && typeof style.img !== 'undefined' ? style.img : '',
    'w-full h-full',
    isEager ? '' : 'lazy',
  ]
    .filter(Boolean)
    .join(' ');

  const size = readSize(basePath);
  const sizeAttr = size ? ` width="${size.width}" height="${size.height}"` : '';
  const loadAttr = isEager
    ? ' loading="eager" fetchpriority="high"'
    : ' loading="lazy"';
  const stamp = hash(8);
-%>
<figure<%- typeof style !== 'undefined' && style.main !== 'undefined' ? ` class="${ style.main }"` : '' %>>
  <% if ( webpPath ) { -%>
  <picture>
    <source srcset="<%= webpPath %>?<%= stamp %>" type="image/webp">
    <img class="<%- imgClass %>" <%- altAttr %><%- sizeAttr %><%- loadAttr %> decoding="async"
      src="<%= basePath %>?<%= stamp %>">
  </picture>
  <% } else { -%>
  <img class="<%- imgClass %>" <%- altAttr %><%- sizeAttr %><%- loadAttr %> decoding="async"
    src="<%= basePath %>?<%= stamp %>">
  <% } -%>
  </figure>
