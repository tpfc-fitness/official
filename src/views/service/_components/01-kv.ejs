<%/* KV：滿版主視覺 */%>
<%
  /*
   * 這一段只有照片，標題在下一段 —— 設計稿把 h1 放在 KV 底下的文字區，
   * 不壓在照片上。照片仍是首屏，所以走 eager。
   */
  const { kv } = require('_data/service.js');
-%>
<section class="overflow-hidden bg-[var(--x15)]">
  <%- require('img.ejs')({
    /* 首屏圖片：立即載入並提高優先度 */
    eager: true,
    path: kv.img,
    alt: kv.alt,
    style: {
      main: 'w-full p:h-[420px] t:h-[300px] m:h-[200px]',
      img: 'object-cover object-center'
    }
  }) %>
</section>
