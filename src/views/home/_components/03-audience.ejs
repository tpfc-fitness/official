<%/* 適合什麼樣的人報名 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-audience，使用的頁面樣式表必須引入它。
   *
   * 四種人，四張卡。編號用主色的大字當標記 ——
   * 讀者會在裡面找自己，編號讓「有四種」這件事一眼看得出來。
   */
  const AUDIENCE = [
    {
      no: '01',
      icon: 'icon_book',
      title: '健身新手',
      body: '第一次接觸重量訓練，不知道器材怎麼用、動作怎麼做，也擔心自己練會受傷。',
    },
    {
      no: '02',
      icon: 'icon_growth',
      title: '已經有訓練經驗',
      body: '練了一段時間，卻常常不知道動作對不對、訓練怎麼安排，體態也沒有明顯進步。',
    },
    {
      no: '03',
      icon: 'icon_posture',
      title: '想改善體態',
      body: '希望透過重量訓練增肌、減脂或改善體態，卻不知道該如何開始。',
    },
    {
      no: '04',
      icon: 'icon_dumbel',
      title: '想逐漸能自己訓練',
      body: '希望不只是跟著教練做，而是理解訓練方法，未來也能自己到健身房訓練。',
    },
  ];
-%>
<section
  class="text-[var(--white)] bg-[var(--x15)] p:px-[80px] p:py-[90px] t:px-[40px] t:py-[60px] m:px-[20px] m:py-[42px]">
  <div class="p:max-w-[1240px] pt:mx-auto">
    <header data-aos="fade-up" class="text-center">
      <h2 class="leading-[1.4] tracking-[-0.05em] font-black p:text-[48px] t:text-[36px] m:text-[28px]">
        適合什麼樣的人報名？
      </h2>
      <p class="leading-[1.9] p:mt-[18px] tm:mt-[12px] p:text-[16px] tm:text-[14px] text-[var(--xc7)]">
        不管你是剛開始接觸重量訓練，還是已經練了一段時間，<br class="pt:hidden" />都可以從適合自己的方式開始。
      </p>
    </header>

    <%/* 桌機四欄：每段說明都在四十字以內，壓到 300px 寬仍讀得順 */%>
    <ul
      class="m-audience grid p:mt-[60px] t:mt-[44px] m:mt-[30px] p:grid-cols-4 p:gap-[36px] t:grid-cols-2 t:gap-[32px] m:grid-cols-1">
      <% AUDIENCE.forEach((item) => { -%>
      <li data-aos="fade-up">
        <div class="m-audience-head">
          <p class="m-audience-no"><%= item.no %></p>
          <h3 class="m-audience-title"><%= item.title %></h3>
          <%- require('@component/svg.ejs')({
            svgName: item.icon,
            style: { main: 'm-audience-icon' }
          }) %>
        </div>
        <i class="m-audience-rule"></i>
        <p class="m-audience-body"><%= item.body %></p>
      </li>
      <% }); -%>
    </ul>
  </div>
</section>
