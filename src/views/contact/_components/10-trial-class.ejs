<%/* 免費體驗課內容 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-step，使用的頁面樣式表必須引入它。
   */
  const trial = require('_data/trial-class.js');
-%>
<section
  class="text-[var(--white)] bg-[var(--black)] p:pt-[90px] p:pb-[120px] t:pt-[75px] t:pb-[105px] m:pt-[40px] m:pb-[60px] p:px-[60px] t:px-[40px] m:px-[20px]">
  <header class="text-center p:pb-[70px] t:pb-[56px] m:pb-[40px]">
    <h2 class="resevation-h1"><% trial.title.forEach((line, i) => { %><%- i ? '<br />' : '' %><%= line %><% }); %></h2>
    <p class="resevation-p p:mt-[18px] tm:mt-[12px]"><%= trial.lead %></p>
  </header>

  <ol class="m-step p:max-w-[860px] pt:mx-auto">
    <% trial.steps.forEach((step) => { -%>
    <li data-aos="fade-up">
      <p class="m-step-no"><%= step.no %></p>

      <h3 class="font-bold leading-[1.4] p:text-[22px] t:text-[20px] m:text-[17px]"><%= step.title %></h3>

      <% if (step.note) { -%>
      <p class="p:mt-[6px] tm:mt-[4px] p:text-[13px] tm:text-[12px] text-[var(--x6)]"><%= step.note %></p>
      <% } -%>

      <div class="p:mt-[16px] tm:mt-[12px] p:space-y-[10px] tm:space-y-[8px]">
        <% step.body.forEach((line) => { -%>
        <p class="leading-[1.9] p:text-[15px] tm:text-[13px] text-[var(--xc7)]"><%- line %></p>
        <% }); -%>
      </div>

      <% if (step.questions) { -%>
      <ul class="m-step-questions p:mt-[16px] tm:mt-[12px]">
        <% step.questions.forEach((q) => { -%>
        <li><%= q %></li>
        <% }); -%>
      </ul>
      <% } -%>

      <% if (step.after) { -%>
      <div class="p:mt-[16px] tm:mt-[12px] p:space-y-[10px] tm:space-y-[8px]">
        <% step.after.forEach((line) => { -%>
        <p class="leading-[1.9] p:text-[15px] tm:text-[13px] text-[var(--xc7)]"><%- line %></p>
        <% }); -%>
      </div>
      <% } -%>
    </li>
    <% }); -%>
  </ol>
</section>
