<%/* 頭等倉教練的訓練方針 */%>
<% const resevation = require('_data/resevation.js'); -%>
<!-- 訓練方針 -->
<section data-aos="fade-in" class="p:pt-[90px] p:pb-[120px] t:py-[75px] m:py-[40px]">
  <h2 class="resevation-h1 deco-header p:mb-[70px] t:mb-[40px] m:mb-[40px] text-[#fff]">頭等倉教練的訓練方針</h2>
  <div class="m-slider pt:mx-auto p:max-w-[1220px] pt:mb-[40px] m:mb-[28px]">
    <ul class="training-rules-slider pt:flex">
      <% resevation.trainingRules.forEach((item) => { -%>
      <li class="p:w-1/4 m:h-[320px]">
        <div
          class="bg-[#fff] space-y-[12px] h-full p:mx-[10px] p:px-[24px] p:py-[32px] t:px-[20px] t:py-[28px] m:px-[24px] m:py-[32px]">
          <p class="resevation-h4 flex items-center">
            <%- require('@component/svg.ejs')({
              svgName: 'icon_bow',
              style: {
                main: 'w-[32px] h-[32px] mr-[8px]'
              }
            }) %>
            <%= item.subTitle %>
          </p>
          <h3 class="resevation-h3 deco-line"><%= item.title %></h3>
          <ul>
            <% item.content.forEach((li) => { -%>
            <li>
              ✅ <span class="resevation-p"><%- li %></span>
            </li>
            <% }); -%>
          </ul>
        </div>
      </li>
      <% }); -%>
    </ul>
    <div class="m-slider-ctrl training-rules-slider-ctrl p:hidden">
      <button type="button" class="m-slider-prev">
        <span class="sr-only">上一張</span>
      </button>
      <button type="button" class="m-slider-next">
        <span class="sr-only">下一張</span>
      </button>
    </div>
  </div>
  <p class="text-[#fff] text-center pt:mb-[50px] m:mb-[20px] m:px-[12px]">
    或許你已經努力過了好幾次<br>但有可能只是方式不對<br><br>我們已經幫助百位學員成功蛻變、重拾自信<br>他們也和你一樣<br>只是一般的上班族，有家庭要顧、有工作要忙、也有吃美食的慾望<br>卻都在這裡找到了適合自己的訓練方式<br>輕鬆養成習慣、穩定看見成果<br><br>如果他們都能做到，你也一定可以！
  </p>
  <%- require('@component/mBtn.ejs')({
    label: '預約免費體驗課',
    link: undefined,
    type: 'button',
    func: 'scrollToResevation()',
    style: {
      main: '--highlight mx-auto p:text-[18px] text-[var(--white)] p:w-[270px] p:h-[50px] t:w-[216px] t:h-[60px] m:w-[220px] m:h-[56px]'
    }
  }) %>
</section>
