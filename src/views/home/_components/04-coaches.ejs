<%/* 教練團隊摘要 */%>
<section
  class="text-[var(--white)] bg-[var(--black)] p:px-[80px] p:py-[70px] t:px-[40px] t:py-[50px] m:px-[20px] m:py-[40px]">

  <%/* 標題列：桌機為「大標｜說明｜裝飾線＋標語」三段；平板去掉標語；手機置中疊放 */%>
  <div data-aos="fade-up" class="pt:flex pt:items-start p:mb-[36px] t:mb-[28px] m:mb-[24px]">
    <h2
      class="font-black tracking-[-0.05em] leading-none flex-shrink-0 p:text-[64px] t:text-[40px] m:text-[32px] m:text-center">
      教練團隊</h2>
    <div
      class="t:border-l t:border-solid t:border-[rgb(255_255_255_/_30%)] p:ml-[60px] t:ml-[28px] t:pl-[28px] p:pt-[8px] m:mt-[10px]">
      <p class="leading-[1.7] p:text-[15px] t:text-[14px] m:text-[14px] m:text-center">不同專長的教練，<br
          class="m:hidden">陪你找到適合自己的訓練方式。</p>
    </div>
    <%/* 裝飾標語：僅桌機顯示 */%>
    <div class="flex items-center flex-grow justify-end tm:hidden pt-[10px]">
      <i class="m-coach-rule w-[140px] mr-[24px]"></i>
      <p class="text-[11px] leading-[1.8] tracking-[0.18em] text-right text-[rgb(255_255_255_/_55%)]">MORE THAN A
        GYM<br>A STRONGER YOU</p>
    </div>
  </div>

  <%- require('@component/mCoachPreview.ejs')() %>

  <%/* 頁尾裝飾：僅桌機顯示 */%>
  <div class="flex items-center tm:hidden mt-[44px] text-[11px] tracking-[0.18em] text-[rgb(255_255_255_/_45%)]">
    <span class="flex-shrink-0 mr-[20px]">TEAM</span>
    <i class="m-coach-rule w-[420px]"></i>
    <span class="flex-grow text-right">TRAIN&nbsp;&nbsp;/&nbsp;&nbsp;PROGRESS&nbsp;&nbsp;/&nbsp;&nbsp;TOGETHER</span>
  </div>
</section>
