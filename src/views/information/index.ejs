<%
  /* build 期讀取：地址、營業時間、環境照片說明全部進得了 HTML */
  const information = require('_data/information.js');
-%>
<section
  class="p:pt-[20px] text-[var(--white)] bg-[var(--black)] flex tm:flex-col items-center m:py-[30px] m:px-[20px]">
  <div data-aos="fade-up"
    class="text-center p:w-1/4 t:py-[50px] t:w-full t:border-b-[1px] t:border-solid t:border-[var(--white)] m:sr-only">
    <h1 class="inline-block p:rotate-[270deg] p:text-left leading-[1.2] font-black p:text-[40px] t:text-[52px]">交通資訊
    </h1>
  </div>
  <div
    class="p:flex p:items-center p:border-l-[1px] border-solid border-[var(--white)] p:mb-[20px] p:w-3/4 t:py-[30px]">
    <iframe title="頭等倉運動空間位置地圖"
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3002.179049137687!2d121.52289464682998!3d25.06259503770268!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3442a9738373e79f%3A0xe6b04fcd0b6f58f0!2z6aCt562J5YCJ6YGL5YuV56m66ZaTZmlyc3QgY2xhc3M!5e0!3m2!1szh-TW!2stw!4v1789045680512!5m2!1szh-TW!2stw"
      loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen
      class="border-0 p:ml-[20px] p:w-[363px] p:h-[500px] tm:w-full t:h-[420px] m:h-[300px] m:mb-[20px]"></iframe>
    <div data-aos="fade-in" class="p:ml-[20px] p:w-[454px] t:p-[30px]">
      <h3 class="font-bold p:text-[26px] p:mb-[40px] tm:text-[24px] tm:mb-[20px]">FIRST CLASS FITNESS<br />頭等倉運動空間 中山店
      </h3>
      <ul class="m-p:space-y-[36px] tm:space-y-[16px]">
        <% information.location.forEach((item) => { -%>
        <li>
          <h3 class="font-bold p:mb-[4px] p:text-[18px] tm:text-[20px]"><%- item.title %></h3>
          <p class="p:text-[15px] tm:text-[14px]"><%- item.cnt %></p>
        </li>
        <% }); -%>
      </ul>
    </div>
  </div>
</section>
<section class="text-[var(--white)] bg-[var(--x15)] p:py-[60px] t:text-center tm:py-[20px]">
  <div data-aos="fade-up" class="p:box-content p:pl-[12vw] p:w-[620px] p:mb-[60px] t:mb-[52px] m:mb-[16px] m:px-[20px]">
    <h3 class="font-bold p:text-[40px] tm:text-[32px] tm:mb-[4px]">頭等倉環境導覽</h3>
    <p class="font-bold p:mb-[4px] p:text-[18px] tm:text-[20px]">專注訓練，也保留讓人舒服使用的空間。</p>
    <p class="p:text-[15px] tm:text-[14px]">
      頭等倉以重量訓練為主要訓練內容，空間規劃以實際訓練需求為主，設有自由重量、固定式器材及有氧訓練設備，並提供休息、飲水、儲物與盥洗等基本機能。<br /><br />不論是教練課或自主訓練，都能在相對單純的環境中完成自己的訓練。
    </p>
  </div>
  <div class="m-slider">
    <ul class="env-slider">
      <% information.env.forEach((item) => { -%>
      <li class="slide">
        <div class="relative">
          <%- require('img.ejs')({
            path: item.img,
            alt: item.title,
            style: {
              main: 'flex-shrink-0 m:h-[280px]',
              img: 'object-cover object-right !w-full'
            }
          }) %>
          <div class="absolute bottom-0 left-0 w-full bg-[#000] bg-opacity-70 p:p-[24px] t:p-[16px] m:p-[12px]">
            <p class="text-left pt:text-[16px] m:text-[14px]"><%= item.cnt %></p>
          </div>
        </div>
      </li>
      <% }); -%>
    </ul>
    <div class="m-slider-ctrl">
      <button type="button" class="m-slider-prev">
        <span class="sr-only">prev</span>
      </button>
      <button type="button" class="m-slider-next">
        <span class="sr-only">next</span>
      </button>
    </div>
  </div>
</section>
