<%/* 文章本體：先說結論 + 依 blocks 依序渲染 + 作者 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-article，使用的頁面樣式表必須引入它。
   *
   * blocks 是有順序的陣列，不是固定欄位 —— 每篇文章的段落組成都不同，
   * 寫死「為什麼／常見錯誤／怎麼判斷…」的話，只用得到其中三段的文章
   * 就會留下三個空標題。
   */
-%>
<article class="m-article-body">
  <div class="m-article-container">

    <%/* 先說結論：給趕時間的讀者與生成式搜尋直接引用的一段 */%>
    <div class="m-article-answer">
      <p class="m-article-label">先說結論</p>
      <p class="m-article-answer-text"><%- article.directAnswer %></p>
    </div>

    <% article.blocks.forEach((block) => { -%>
    <% if (block.h2) { -%>
    <h2 class="m-article-h2"><%= block.h2 %></h2>
    <% } else if (block.h3) { -%>
    <h3 class="m-article-h3"><%= block.h3 %></h3>
    <% } else if (block.p) { -%>
    <%/* 不轉義輸出：段落裡可以寫 b 與 a 這類行內標記 */%>
    <p class="m-article-p"><%- block.p %></p>
    <% } else if (block.img) { -%>
    <%- require('@component/articleImg.ejs')({
      src: block.img,
      alt: block.alt,
      style: {
        main: 'm-article-image',
        /* 覆寫 img.ejs 固定給的 w-full h-full —— 理由見 _modules/m-article */
        img: 'object-contain object-center mx-auto max-w-full !w-auto !h-auto m:!max-h-[420px] pt:!max-h-[560px]'
      }
    }) %>
    <% } else if (block.embed) { -%>
    <%/*
      Instagram Reel。用 iframe 而不是官方的 embed.js ——
      那支 script 會在每個讀者身上多跑一次第三方追蹤，
      而這裡只是要播一段影片。lazy 讓它捲到才載入。
    */%>
    <div class="m-article-embed">
      <iframe src="<%= block.embed %>embed" title="Instagram 影片" loading="lazy" allowfullscreen scrolling="no"></iframe>
    </div>
    <% } -%>
    <% }); -%>

    <%/*
      頭像直接用教練團隊頁的照片，靠 author.name 對應 _data/coach.js 的 name。
      對不到（名字打錯或不是教練寫的）就只顯示文字，不放空的圓。
    */%>
    <% const authorCoach = require('_data/coach.js').find((item) => item.name === article.author.name); -%>
    <section class="m-article-author">
      <p class="m-article-label">AUTHOR</p>
      <div class="m-article-author-row">
        <% if (authorCoach) { -%>
        <%- require('@component/img.ejs')({
          path: authorCoach.img,
          decorative: true,
          style: {
            main: 'm-article-author-avatar',
            img: 'object-cover object-[center_25%]'
          }
        }) %>
        <% } -%>
        <div>
          <p class="m-article-author-name"><%= article.author.name %></p>
          <p class="m-article-author-role"><%= article.author.role %></p>
        </div>
      </div>
      <%/*
        證照與教練介紹的連結。
        讀者（與搜尋引擎、AI）判斷「這篇可不可信」時，會看是誰寫的、有沒有相關資格。
        結構化資料裡宣告的證照，畫面上也一定要看得到 —— Google 規定兩邊要一致，
        所以這裡跟 _components/mJsonLd.ejs 吃同一份 coach.js 的 credentials（certificates 裡標了 credential 的那幾筆）。
      */%>
      <% if (authorCoach && authorCoach.credentials) { -%>
      <ul class="m-article-author-credentials" aria-label="證照">
        <% authorCoach.credentials.forEach((credential) => { -%>
        <li><%= credential %></li>
        <% }); -%>
      </ul>
      <% } -%>
      <% if (authorCoach) { -%>
      <a class="m-article-author-link"
        href="<%= process.env.ROOT_DIRECTORY %>ourteam.html#coach-<%= authorCoach.slug %>">
        看 <%= authorCoach.name %> 的教練介紹 →
      </a>
      <% } -%>
    </section>
  </div>
</article>
