<header
  class="m-hd p:h-[72px] p:px-[20px] t:px-[15px] m:px-[10px] tm:h-[70px] w-full flex items-center bg-[var(--black)]">
  <%/* 這裡是網站識別（logo），不是本頁標題，所以不使用 h1。
       每一頁的 h1 定義在各自的 view 裡 */%>
  <div class="flex-grow flex items-center">
    <a href="./" class="m-hd-logo pt:inline-block m:flex m:items-center" rel="noopener" data-aos="fade-in">
      <%- require('@component/svg.ejs')({
        svgName: 'logo_sub',
        style: {
          main: 'text-[var(--white)] p:w-[260px] p:h-[55px] t:w-[216px] t:h-[60px] m:w-[180px] m:h-[50px]'
        }
      }) %>
      <em class="sr-only">
        <%- process.env.PROJECT_NAME %>
      </em>
    </a>
  </div>
  <%- require('@component/mNav.ejs')({ filename: typeof filename !== 'undefined' ? filename : '' }) %>
</header>
