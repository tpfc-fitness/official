<%/* KV 主視覺：標題依網址參數 ?type= 切換，見 _data/contact-kv.js */%>
<%
  const kv = require('_data/contact-kv.js');
  const site = require('_data/site.js');
  /* HTML 只輸出預設那一組，維持單一 h1；其餘由 JS 抽換 */
  const preset = kv.VARIANTS[kv.DEFAULT];
  const [titleHead, titleTail] = kv.splitTitle(preset.title);
-%>
<section class="m-kv relative overflow-hidden text-[var(--white)]">
  <%- require('img.ejs')({
    /* 首屏圖片：立即載入並提高優先度 */
    eager: true,
    path: require('@imgs/contact/kv-main.jpg'),
    alt: '教練指導學員進行重量訓練',
    style: {
      main: 'absolute inset-0 z-0',
      img: 'object-cover object-center'
    }
  }) %>

  <div class="m-kv-body relative z-[2] p:px-[70px] p:py-[90px] t:px-[40px] t:py-[60px] m:px-[20px] m:py-[44px]">
    <p class="text-[11px] tracking-[0.24em] text-[var(--xe120)] font-bold">FIRST CLASS FITNESS</p>

    <h1 data-aos="fade-up" data-kv-title
      class="font-black leading-[1.25] tracking-[-0.03em] p:mt-[18px] tm:mt-[12px] p:text-[54px] t:text-[34px] m:text-[26px] p:max-w-[15ch]">
      <%= titleHead %><br /><%= titleTail %></h1>

    <p data-aos="fade-up" data-kv-lead
      class="leading-[1.9] p:mt-[22px] tm:mt-[14px] p:text-[15px] tm:text-[13px] p:max-w-[46ch] text-[rgb(255_255_255_/_85%)]">
      <%= preset.lead %></p>

    <p class="flex items-center p:mt-[28px] tm:mt-[18px] p:text-[14px] tm:text-[12px]">
      <%- require('@component/svg.ejs')({
        svgName: 'icon_pin',
        style: {
          main: 'flex-shrink-0 text-[var(--xe120)] p:w-[14px] p:h-[18px] tm:w-[12px] tm:h-[15px] mr-[8px]'
        }
      }) %>
      <%= site.address.addressRegion %><%= site.address.addressLocality %>｜民權西路站步行約 3 分鐘
    </p>

    <%- require('@component/mBtn.ejs')({
      label: '免費預約體驗',
      link: '#resevation',
      style: {
        main: '--highlight p:mt-[34px] tm:mt-[24px] p:w-[236px] p:h-[54px] t:w-[212px] t:h-[50px] m:w-full m:h-[48px] p:text-[16px] tm:text-[15px]',
        icon: 'w-[44px]'
      },
      icon: {
        name: 'arrow',
        css: 'p:w-[18px] p:h-[18px] tm:w-[18px] tm:h-[18px]'
      },
      fadeType: 'fade-up'
    }) %>
  </div>
</section>
