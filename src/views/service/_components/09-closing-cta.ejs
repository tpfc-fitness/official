<%/* 結尾行動呼籲 */%>
<%
  /*
   * ⚠️ 這個區塊用到 _modules/m-bg-photo 與 _modules/m-service，
   *    使用的頁面樣式表必須引入它們。
   *
   * 頁尾 footer 本來就有一顆「即刻預約」，這一段不是重複 ——
   * footer 的那顆是全站共用的，這一段收的是「讀完整頁之後」的那個人。
   */
  const { closing } = require('_data/service.js');
-%>
<section class="m-bg-photo --cta-service relative overflow-hidden text-[var(--white)]">
  <%/* 底圖：純氛圍，alt 留空 */%>
  <%- require('img.ejs')({
    decorative: true,
    path: closing.bg,
    style: {
      main: 'm-bg-photo-img',
      img: 'object-cover object-center'
    }
  }) %>

  <%/* 桌機文字與按鈕左右並排，平板與手機置中堆疊 */%>
  <div
    class="relative z-[1] p:max-w-[1200px] p:mx-auto p:flex p:items-center p:justify-between p:gap-[60px] p:px-[60px] p:py-[90px] t:px-[40px] t:py-[64px] m:px-[20px] m:py-[48px] tm:text-center">
    <div data-aos="fade-up">
      <p class="m-sec-eyebrow"><%= closing.eyebrow %></p>
      <h2
        class="font-black leading-[1.35] tracking-[-0.03em] p:mt-[14px] tm:mt-[10px] p:text-[38px] t:text-[30px] m:text-[24px]">
        <% closing.title.forEach((line, i) => { %><%- i ? '<br />' : '' %><%= line %><% }); %></h2>
    </div>

    <div data-aos="fade-up" class="p:flex-shrink-0 tm:mt-[28px]">
      <%- require('@component/mBtn.ejs')({
        label: closing.cta.label,
        link: closing.cta.link,
        style: {
          main: '--highlight p:w-[260px] p:h-[54px] t:w-[300px] t:h-[52px] m:w-full m:h-[48px] tm:mx-auto p:text-[17px] tm:text-[15px]',
          icon: 'w-[44px]'
        },
        icon: {
          name: 'arrow',
          css: 'w-[18px] h-[18px]'
        }
      }) %>

      <p class="m-place tm:justify-center p:mt-[18px] tm:mt-[16px]">
        <%- require('@component/svg.ejs')({
          svgName: 'icon_pin',
          style: { main: 'm-place-icon' }
        }) %>
        <span><%= closing.place %></span>
      </p>
    </div>
  </div>
</section>
